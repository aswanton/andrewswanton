  .experiment { margin-top: 21px; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .scene-heading { display: flex; justify-content: space-between; align-items: center; padding: 0 0 12px; color: #70819a; font-size: .64rem; letter-spacing: .12em; font-weight: 800; }
  .scene-heading > span:first-child { display: flex; align-items: center; gap: 9px; color: #35527c; }
