---
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f3f7fc" />
    <meta
      name="description"
      content="Explore an interactive water simulation with a randomized shoreline, detailed CC0 plant models, HDR environment lighting, swimming fish, and a steerable sailboat."
    />
    <title>Interactive Water | Andrew Swanton</title>
  </head>

  <body>
    <main>
      <header>
        <a class="logo" href="/" aria-label="Andrew Swanton home">AS<span>.</span></a>
        <nav aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/#projects">Projects</a>
        </nav>
      </header>

      <section class="intro">
        <a class="back-link" href="/#projects">← Back to projects</a>
        <p class="eyebrow"><span class="eyebrow-mark"></span> EXPERIMENT 001 · PHYSICS & GRAPHICS</p>
        <h1>Water,<br /><span>in motion.</span></h1>
        <p class="lead">
          Every visit generates a new freeform basin and shoreline. Steer a little sailboat
          through the changing world, watch the wildlife swim, and catch a fish leaping
          from the water now and then.
        </p>
      </section>

      <section class="experiment" aria-labelledby="experiment-title">
        <h2 id="experiment-title" class="visually-hidden">Interactive water simulation</h2>
        <div class="scene-heading">
          <span><span class="live-dot"></span> LIVE SIMULATION</span>
          <span>3D INTERACTIVE POOL</span>
        </div>
        <div class="water-stage">
          <canvas
            id="water"
            tabindex="0"
            aria-label="Three-dimensional pool surrounded by a randomly generated grassy shoreline with trees, bushes, and wandering wildlife. Steer the sailboat with arrow keys, drag the sphere or camera, or click the water to make a ripple."
          >          </canvas>
          <span id="ripple-impact" aria-hidden="true"></span>
          <p class="scene-hint" id="scene-hint" aria-live="polite">↑ forward · ↓ reverse · ←/→ steer · drag the sphere or water</p>
        </div>
        <div class="controls">
          <div class="wind-control">
            <label for="wind">WIND <output id="wind-value" for="wind">38%</output></label>
            <input id="wind" type="range" min="0" max="100" value="38" />
            <div class="range-labels"><span>CALM</span><span>BREEZY</span></div>
          </div>
          <button class="drop-button" id="drop" type="button">
            <span class="drop-icon" aria-hidden="true">↓</span>
            Drop a stone
          </button>
        </div>
      </section>

      <section class="notes">
        <div class="notes-heading">
          <p class="eyebrow">UNDER THE SURFACE</p>
          <h2>A little physics.<br />A lot of light.</h2>
        </div>
        <div class="note-list">
          <article class="note">
            <span class="note-number">01</span>
            <div>
              <h3>Waves with momentum</h3>
              <p>A damped wave equation carries each splash across the pool, where crests and troughs spread, overlap, and follow the duck's gentle wake without changing the pool's total water volume.</p>
            </div>
          </article>
          <article class="note">
            <span class="note-number">02</span>
            <div>
              <h3>Ripples you can make</h3>
              <p>Steer the sailboat with the arrow keys while the mallard cruises and dabbles around the pool. Push the floating sphere or drop a stone to send waves across the water.</p>
            </div>
          </article>
          <article class="note">
            <span class="note-number">03</span>
            <div>
              <h3>Reflections that move</h3>
              <p>An HDR environment adds natural sky and landscape lighting to detailed CC0 shoreline models, while moving wave normals bend highlights across the water.</p>
            </div>
          </article>
        </div>
      </section>

      <p class="caveat">
        The shoreline models and HDR environment are CC0 assets from Poly Haven; see the <a href="/assets/polyhaven/CC0-CREDITS.txt">asset credits</a>. Water and wildlife are rendered in real time, and the surface waves are an approximation—not a full fluid or ray-tracing simulation. Disturbances are balanced against surrounding troughs so the pool's mean water level stays constant.
        It is a work in progress—part physics experiment, part rendering study.
      </p>

      <footer>
        <span>© {new Date().getFullYear()} Andrew Swanton</span>
        <a href="mailto:hello@andrewswanton.com">Get in touch ↗</a>
      </footer>
    </main>
  </body>
</html>

<script>
  import * as THREE from "three";
  import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";
  import { HDRLoader } from "three/addons/loaders/HDRLoader.js";
  import { Water } from "three/addons/objects/Water.js";

  const canvas = document.querySelector<HTMLCanvasElement>("#water");
  const stage = document.querySelector<HTMLElement>(".water-stage");
  const hint = document.querySelector<HTMLElement>("#scene-hint");
  const rippleImpact = document.querySelector<HTMLElement>("#ripple-impact");
  const windSlider = document.querySelector<HTMLInputElement>("#wind");
  const windOutput = document.querySelector<HTMLOutputElement>("#wind-value");
  const dropButton = document.querySelector<HTMLButtonElement>("#drop");

  if (!canvas || !stage || !hint || !rippleImpact || !windSlider || !windOutput || !dropButton) {
    throw new Error("The interactive water simulation could not initialize.");
  }

  let renderer: THREE.WebGLRenderer;
  try {
    renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      powerPreference: "high-performance",
    });
  } catch (error) {
    hint.textContent = "This browser couldn't start the 3D water scene. Try a browser with WebGL enabled.";
    console.error("Unable to create the WebGL renderer for the water experiment.", error);
    throw error;
  }

  const scene = new THREE.Scene();
  const poolWidth = THREE.MathUtils.randFloat(15, 21);
  const poolDepth = THREE.MathUtils.randFloat(12, 18);
  const poolBack = -poolDepth / 2;
  const poolFront = poolDepth / 2;
  const poolFloor = -THREE.MathUtils.randFloat(3.1, 4.1);
  const poolTop = THREE.MathUtils.randFloat(0.95, 1.3);
  const shorelineWidths = {
    back: THREE.MathUtils.randFloat(4, 7.5),
    front: THREE.MathUtils.randFloat(4, 7.5),
    left: THREE.MathUtils.randFloat(4, 7.5),
    right: THREE.MathUtils.randFloat(4, 7.5),
  };
  const shorelinePhase = Math.random() * Math.PI * 2;
  const shorelineSecondPhase = Math.random() * Math.PI * 2;
  const poolShapePhase = Math.random() * Math.PI * 2;
  const poolShapeStrength = THREE.MathUtils.randFloat(0.08, 0.17);
  const worldWidth = poolWidth + Math.max(shorelineWidths.left, shorelineWidths.right) * poolWidth / Math.min(poolWidth, poolDepth) * 2 + 4;
  const worldDepth = poolDepth + Math.max(shorelineWidths.back, shorelineWidths.front) * poolDepth / Math.min(poolWidth, poolDepth) * 2 + 4;
  const worldSpan = Math.max(worldWidth, worldDepth);
  function poolShapeFactor(angle: number) {
    return 1 +
      Math.sin(angle * 2 + poolShapePhase) * poolShapeStrength +
      Math.sin(angle * 3 - poolShapePhase * 0.7) * poolShapeStrength * 0.32;
  }
  function shoreShapeFactor(angle: number) {
    const directionalWidth = (Math.abs(Math.cos(angle)) * (Math.cos(angle) > 0 ? shorelineWidths.right : shorelineWidths.left) +
      Math.abs(Math.sin(angle)) * (Math.sin(angle) > 0 ? shorelineWidths.front : shorelineWidths.back));
    const undulation = 0.75 + 0.2 * Math.sin(angle * 3 + shorelinePhase) +
      0.12 * Math.sin(angle * 5 + shorelineSecondPhase);
    return poolShapeFactor(angle) + directionalWidth * undulation / Math.min(poolWidth, poolDepth) * 2;
  }
  function poolPoint(angle: number, factor = poolShapeFactor(angle)) {
    return new THREE.Vector3(
      Math.cos(angle) * poolWidth * 0.5 * factor,
      0,
      Math.sin(angle) * poolDepth * 0.5 * factor,
    );
  }
  function poolBoundaryFactor(angle: number, margin = 0) {
    const radialMargin = margin / Math.min(poolWidth, poolDepth) * 2;
    return Math.max(0, poolShapeFactor(angle) - radialMargin);
  }
  function poolFloorHeight(x: number, z: number) {
    const angle = Math.atan2(z / (poolDepth * 0.5), x / (poolWidth * 0.5));
    const radius = Math.hypot(x / (poolWidth * 0.5), z / (poolDepth * 0.5));
    const slope = THREE.MathUtils.smoothstep(radius / poolShapeFactor(angle), 0.58, 0.965);
    return THREE.MathUtils.lerp(poolFloor, -0.035, slope);
  }
  function poolWaveEdgeFade(x: number, z: number) {
    const angle = Math.atan2(z / (poolDepth * 0.5), x / (poolWidth * 0.5));
    const radius = Math.hypot(x / (poolWidth * 0.5), z / (poolDepth * 0.5));
    return THREE.MathUtils.smoothstep(poolShapeFactor(angle) - radius, -0.015, 0.14);
  }
  function keepInsidePool(position: THREE.Vector3, margin = 0) {
    const angle = Math.atan2(position.z / (poolDepth * 0.5), position.x / (poolWidth * 0.5));
    const limit = poolBoundaryFactor(angle, margin);
    const radial = Math.hypot(position.x / (poolWidth * 0.5), position.z / (poolDepth * 0.5));
    if (radial > limit) {
      const scale = limit / Math.max(radial, 0.001);
      position.x *= scale;
      position.z *= scale;
    }
    return position;
  }
  function makeRadialGeometry(
    innerFactor: (angle: number) => number,
    outerFactor: (angle: number) => number,
    radialSegments: number,
    angularSegments: number,
    height: (x: number, z: number) => number,
    fillCenter = true,
  ) {
    const positions: number[] = [0, height(0, 0), 0];
    const uvs: number[] = [0.5, 0.5];
    const indices: number[] = [];
    const firstRing = fillCenter ? 1 : 0;
    for (let ring = firstRing; ring <= radialSegments; ring++) {
      const progress = ring / radialSegments;
      for (let segment = 0; segment < angularSegments; segment++) {
        const angle = (segment / angularSegments) * Math.PI * 2;
        const radius = THREE.MathUtils.lerp(innerFactor(angle), outerFactor(angle), progress);
        const point = poolPoint(angle, radius);
        positions.push(point.x, height(point.x, point.z), point.z);
        uvs.push(0.5 + point.x / worldWidth, 0.5 + point.z / worldDepth);
      }
    }

    if (fillCenter) {
      for (let segment = 0; segment < angularSegments; segment++) {
        const next = (segment + 1) % angularSegments;
        indices.push(0, 1 + next, 1 + segment);
      }
    }
    for (let ring = firstRing; ring < radialSegments; ring++) {
      const currentStart = 1 + (ring - firstRing) * angularSegments;
      const nextStart = currentStart + angularSegments;
      for (let segment = 0; segment < angularSegments; segment++) {
        const next = (segment + 1) % angularSegments;
        const a = currentStart + segment;
        const b = currentStart + next;
        const c = nextStart + segment;
        const d = nextStart + next;
        indices.push(a, b, c, b, d, c);
      }
    }

    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute("position", new THREE.Float32BufferAttribute(positions, 3));
    geometry.setAttribute("uv", new THREE.Float32BufferAttribute(uvs, 2));
    geometry.setIndex(indices);
    geometry.computeVertexNormals();
    return geometry;
  }
  scene.fog = new THREE.Fog(0xb9c9c5, worldSpan * 1.2, worldSpan * 2.65);
  const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 180);
  const cameraTarget = new THREE.Vector3(0, -1.2, 0);
  const cameraOffset = new THREE.Vector3(0.48, 0.52, 0.72).normalize().multiplyScalar(worldSpan * 0.78);
  camera.position.copy(cameraTarget).add(cameraOffset);
  camera.lookAt(cameraTarget);
  const cameraSpherical = new THREE.Spherical().setFromVector3(camera.position.clone().sub(cameraTarget));
  const waveSize = 128;
  const waveScale = 5;
  const repeatDistance = 103 / waveScale;
  const waveData = new Float32Array(waveSize * waveSize);
  const previousWaveData = new Float32Array(waveSize * waveSize);
  const nextWaveData = new Float32Array(waveSize * waveSize);
  const disposableResources: Array<THREE.BufferGeometry | THREE.Material | THREE.Texture> = [];
  const environmentCanvas = document.createElement("canvas");
  environmentCanvas.width = 512;
  environmentCanvas.height = 256;
  const environmentContext = environmentCanvas.getContext("2d");
  if (!environmentContext) throw new Error("The environment lighting map could not be created.");
  const skyGradient = environmentContext.createLinearGradient(0, 0, 0, environmentCanvas.height);
  skyGradient.addColorStop(0, "#607f99");
  skyGradient.addColorStop(0.38, "#a9c2c8");
  skyGradient.addColorStop(0.52, "#e6d9bb");
  skyGradient.addColorStop(0.62, "#82937a");
  skyGradient.addColorStop(1, "#344b3b");
  environmentContext.fillStyle = skyGradient;
  environmentContext.fillRect(0, 0, environmentCanvas.width, environmentCanvas.height);
  const sunGlow = environmentContext.createRadialGradient(122, 70, 5, 122, 70, 95);
  sunGlow.addColorStop(0, "rgba(255, 242, 210, 0.9)");
  sunGlow.addColorStop(0.18, "rgba(255, 232, 190, 0.32)");
  sunGlow.addColorStop(1, "rgba(255, 232, 190, 0)");
  environmentContext.fillStyle = sunGlow;
  environmentContext.fillRect(20, 0, 204, 180);
  const environmentTexture = new THREE.CanvasTexture(environmentCanvas);
  environmentTexture.mapping = THREE.EquirectangularReflectionMapping;
  environmentTexture.colorSpace = THREE.SRGBColorSpace;
  environmentTexture.needsUpdate = true;
  scene.environment = environmentTexture;
  scene.environmentIntensity = 0.62;
  scene.background = environmentTexture;
  const normalPixels = new Uint8Array(waveSize * waveSize * 4);
  const normalTexture = new THREE.DataTexture(
    normalPixels,
    waveSize,
    waveSize,
    THREE.RGBAFormat,
    THREE.UnsignedByteType,
  );
  normalTexture.wrapS = THREE.RepeatWrapping;
  normalTexture.wrapT = THREE.RepeatWrapping;
  normalTexture.magFilter = THREE.LinearFilter;
  normalTexture.minFilter = THREE.LinearMipmapLinearFilter;
  normalTexture.generateMipmaps = true;
  normalTexture.colorSpace = THREE.NoColorSpace;
  normalTexture.needsUpdate = true;

  const tileCanvas = document.createElement("canvas");
  tileCanvas.width = 512;
  tileCanvas.height = 512;
  const tileContext = tileCanvas.getContext("2d");
  if (!tileContext) throw new Error("The pool tile texture could not be created.");
  tileContext.fillStyle = "#456c70";
  tileContext.fillRect(0, 0, tileCanvas.width, tileCanvas.height);
  for (let fleck = 0; fleck < 6500; fleck++) {
    const brightness = Math.floor(72 + Math.random() * 70);
    tileContext.fillStyle = `rgba(${brightness}, ${brightness + 18}, ${brightness + 20}, ${Math.random() * 0.22})`;
    tileContext.fillRect(Math.random() * 512, Math.random() * 512, 1 + Math.random() * 2, 1 + Math.random() * 2);
  }
  const tileTexture = new THREE.CanvasTexture(tileCanvas);
  tileTexture.colorSpace = THREE.SRGBColorSpace;
  tileTexture.wrapS = THREE.RepeatWrapping;
  tileTexture.wrapT = THREE.RepeatWrapping;
  tileTexture.repeat.set(4, 4);
  tileTexture.anisotropy = renderer.capabilities.getMaxAnisotropy();

  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.VSMShadowMap;
  renderer.toneMapping = THREE.ACESFilmicToneMapping;
  renderer.toneMappingExposure = 1.12;
  scene.add(new THREE.HemisphereLight(0xd9ecf4, 0x48523a, 1.55));
  const poolLight = new THREE.DirectionalLight(0xffedcf, 3.2);
  poolLight.position.set(-8, 16, 10);
  poolLight.castShadow = true;
  poolLight.shadow.mapSize.set(1536, 1536);
  poolLight.shadow.camera.left = -22;
  poolLight.shadow.camera.right = 22;
  poolLight.shadow.camera.top = 22;
  poolLight.shadow.camera.bottom = -22;
  poolLight.shadow.bias = -0.00015;
  scene.add(poolLight);

  const tileMaterial = new THREE.MeshStandardMaterial({
    color: 0xffffff,
    map: tileTexture,
    roughness: 0.42,
    metalness: 0.03,
    vertexColors: true,
    side: THREE.DoubleSide,
  });
  const floorGeometry = makeRadialGeometry(
    () => 0,
    (angle) => poolShapeFactor(angle) + 0.01,
    36,
    160,
    poolFloorHeight,
  );
  const floorPositions = floorGeometry.attributes.position;
  const floorColors = new Float32Array(floorPositions.count * 3);
  const deepFloorTint = new THREE.Color(0x95a39b);
  const shoreFloorTint = new THREE.Color(0x8f8369);
  const floorTint = new THREE.Color();
  for (let index = 0; index < floorPositions.count; index++) {
    const x = floorPositions.getX(index);
    const z = floorPositions.getZ(index);
    const angle = Math.atan2(z / (poolDepth * 0.5), x / (poolWidth * 0.5));
    const radius = Math.hypot(x / (poolWidth * 0.5), z / (poolDepth * 0.5));
    const shoreBlend = THREE.MathUtils.smoothstep(radius / poolShapeFactor(angle), 0.62, 0.98);
    floorTint.copy(deepFloorTint).lerp(shoreFloorTint, shoreBlend);
    floorTint.toArray(floorColors, index * 3);
  }
  floorGeometry.setAttribute("color", new THREE.Float32BufferAttribute(floorColors, 3));
  const floor = new THREE.Mesh(floorGeometry, tileMaterial);
  floor.receiveShadow = true;
  scene.add(floor);
  disposableResources.push(floorGeometry);

  disposableResources.push(tileMaterial, tileTexture);
  const landSurfaceY = THREE.MathUtils.randFloat(0.14, 0.24);
  const landZones = [
    { angleStart: 0, angleEnd: Math.PI / 2, width: worldWidth / 2, depth: worldDepth / 2 },
    { angleStart: Math.PI / 2, angleEnd: Math.PI, width: worldWidth / 2, depth: worldDepth / 2 },
    { angleStart: Math.PI, angleEnd: Math.PI * 1.5, width: worldWidth / 2, depth: worldDepth / 2 },
    { angleStart: Math.PI * 1.5, angleEnd: Math.PI * 2, width: worldWidth / 2, depth: worldDepth / 2 },
  ];
  const barkCanvas = document.createElement("canvas");
  barkCanvas.width = 256;
  barkCanvas.height = 256;
  const barkContext = barkCanvas.getContext("2d");
  if (!barkContext) throw new Error("The bark texture could not be created.");
  barkContext.fillStyle = "#66503a";
  barkContext.fillRect(0, 0, barkCanvas.width, barkCanvas.height);
  for (let streak = 0; streak < 160; streak++) {
    barkContext.strokeStyle = Math.random() > 0.5
      ? "rgba(25, 19, 13, 0.36)"
      : "rgba(183, 142, 91, 0.23)";
    barkContext.lineWidth = Math.random() * 2 + 0.4;
    barkContext.beginPath();
    barkContext.moveTo(Math.random() * barkCanvas.width, 0);
    barkContext.bezierCurveTo(
      Math.random() * barkCanvas.width,
      barkCanvas.height * 0.32,
      Math.random() * barkCanvas.width,
      barkCanvas.height * 0.68,
      Math.random() * barkCanvas.width,
      barkCanvas.height,
    );
    barkContext.stroke();
  }
  const barkTexture = new THREE.CanvasTexture(barkCanvas);
  barkTexture.colorSpace = THREE.SRGBColorSpace;
  barkTexture.wrapS = THREE.RepeatWrapping;
  barkTexture.wrapT = THREE.RepeatWrapping;
  barkTexture.repeat.set(2, 1);

  const leafCanvas = document.createElement("canvas");
  leafCanvas.width = 256;
  leafCanvas.height = 256;
  const leafContext = leafCanvas.getContext("2d");
  if (!leafContext) throw new Error("The leaf texture could not be created.");
  leafContext.fillStyle = "#486b45";
  leafContext.fillRect(0, 0, leafCanvas.width, leafCanvas.height);
  for (let leaf = 0; leaf < 2400; leaf++) {
    const hue = 82 + Math.random() * 38;
    const lightness = 25 + Math.random() * 28;
    leafContext.fillStyle = `hsla(${hue}, 28%, ${lightness}%, ${0.32 + Math.random() * 0.42})`;
    leafContext.beginPath();
    leafContext.ellipse(
      Math.random() * leafCanvas.width,
      Math.random() * leafCanvas.height,
      1.5 + Math.random() * 3.8,
      0.8 + Math.random() * 1.5,
      Math.random() * Math.PI,
      0,
      Math.PI * 2,
    );
    leafContext.fill();
  }
  const leafTexture = new THREE.CanvasTexture(leafCanvas);
  leafTexture.colorSpace = THREE.SRGBColorSpace;
  leafTexture.wrapS = THREE.RepeatWrapping;
  leafTexture.wrapT = THREE.RepeatWrapping;

  const furCanvas = document.createElement("canvas");
  furCanvas.width = 256;
  furCanvas.height = 256;
  const furContext = furCanvas.getContext("2d");
  if (!furContext) throw new Error("The animal coat texture could not be created.");
  furContext.fillStyle = "#999999";
  furContext.fillRect(0, 0, furCanvas.width, furCanvas.height);
  for (let strand = 0; strand < 3600; strand++) {
    const shade = Math.floor(90 + Math.random() * 100);
    furContext.strokeStyle = `rgba(${shade}, ${shade}, ${shade}, ${0.12 + Math.random() * 0.32})`;
    furContext.lineWidth = Math.random() * 1.2 + 0.3;
    const x = Math.random() * furCanvas.width;
    const y = Math.random() * furCanvas.height;
    furContext.beginPath();
    furContext.moveTo(x, y);
    furContext.lineTo(x + THREE.MathUtils.randFloatSpread(4), y + 3 + Math.random() * 8);
    furContext.stroke();
  }
  const furTexture = new THREE.CanvasTexture(furCanvas);
  furTexture.colorSpace = THREE.SRGBColorSpace;
  furTexture.wrapS = THREE.RepeatWrapping;
  furTexture.wrapT = THREE.RepeatWrapping;

  const grassCanvas = document.createElement("canvas");
  grassCanvas.width = 256;
  grassCanvas.height = 256;
  const grassContext = grassCanvas.getContext("2d");
  if (!grassContext) throw new Error("The shoreline grass texture could not be created.");
  const grassImage = grassContext.createImageData(grassCanvas.width, grassCanvas.height);
  for (let index = 0; index < grassImage.data.length; index += 4) {
    const variation = Math.random() * 38;
    grassImage.data[index] = 38 + variation * 0.62;
    grassImage.data[index + 1] = 76 + variation;
    grassImage.data[index + 2] = 34 + variation * 0.42;
    grassImage.data[index + 3] = 255;
  }
  grassContext.putImageData(grassImage, 0, 0);
  for (let blade = 0; blade < 1300; blade++) {
    const x = Math.random() * grassCanvas.width;
    const y = Math.random() * grassCanvas.height;
    grassContext.strokeStyle = Math.random() > 0.5
      ? "rgba(151, 165, 91, 0.16)"
      : "rgba(21, 49, 28, 0.2)";
    grassContext.lineWidth = Math.random() * 1.2 + 0.35;
    grassContext.beginPath();
    grassContext.moveTo(x, y);
    grassContext.lineTo(x + THREE.MathUtils.randFloatSpread(3), y - Math.random() * 5);
    grassContext.stroke();
  }
  const grassTexture = new THREE.CanvasTexture(grassCanvas);
  grassTexture.colorSpace = THREE.SRGBColorSpace;
  grassTexture.wrapS = THREE.RepeatWrapping;
  grassTexture.wrapT = THREE.RepeatWrapping;
  grassTexture.repeat.set(2.5, 2.5);
  grassTexture.anisotropy = renderer.capabilities.getMaxAnisotropy();
  const grassMaterials = [
    new THREE.MeshStandardMaterial({ color: 0xa2b48a, map: grassTexture, roughness: 0.98 }),
    new THREE.MeshStandardMaterial({ color: 0xc3cf9f, map: grassTexture, roughness: 0.98 }),
    new THREE.MeshStandardMaterial({ color: 0x91a67f, map: grassTexture, roughness: 0.98 }),
  ];
  const shoreCanvas = document.createElement("canvas");
  shoreCanvas.width = 512;
  shoreCanvas.height = 512;
  const shoreContext = shoreCanvas.getContext("2d");
  if (!shoreContext) throw new Error("The shoreline texture could not be created.");
  shoreContext.fillStyle = "#8c8061";
  shoreContext.fillRect(0, 0, shoreCanvas.width, shoreCanvas.height);
  for (let grain = 0; grain < 5200; grain++) {
    const shade = Math.floor(88 + Math.random() * 82);
    shoreContext.fillStyle = `rgba(${shade}, ${shade * 0.91}, ${shade * 0.7}, ${0.08 + Math.random() * 0.2})`;
    shoreContext.beginPath();
    shoreContext.ellipse(
      Math.random() * shoreCanvas.width,
      Math.random() * shoreCanvas.height,
      1 + Math.random() * 3.2,
      0.8 + Math.random() * 2.2,
      Math.random() * Math.PI,
      0,
      Math.PI * 2,
    );
    shoreContext.fill();
  }
  const shoreTexture = new THREE.CanvasTexture(shoreCanvas);
  shoreTexture.colorSpace = THREE.SRGBColorSpace;
  shoreTexture.wrapS = THREE.RepeatWrapping;
  shoreTexture.wrapT = THREE.RepeatWrapping;
  shoreTexture.repeat.set(3, 3);
  const shoreMaterial = new THREE.MeshStandardMaterial({
    color: 0xa99976,
    map: shoreTexture,
    roughness: 0.96,
    side: THREE.DoubleSide,
  });
  const beachGeometry = makeRadialGeometry(
    (angle) => poolShapeFactor(angle) - 0.035,
    (angle) => poolShapeFactor(angle) + 0.09,
    10,
    160,
    (x, z) => {
      const angle = Math.atan2(z / (poolDepth / 2), x / (poolWidth / 2));
      const radius = Math.hypot(x / (poolWidth / 2), z / (poolDepth / 2));
      const slope = THREE.MathUtils.smoothstep(
        (radius - (poolShapeFactor(angle) - 0.035)) / 0.125,
        0,
        1,
      );
      const terrainVariation =
        Math.sin(x * 0.38) * 0.035 +
        Math.sin(z * 0.43) * 0.035 +
        Math.sin((x + z) * 0.68) * 0.025;
      return THREE.MathUtils.lerp(-0.035, landSurfaceY + terrainVariation, slope);
    },
    false,
  );
  const beach = new THREE.Mesh(beachGeometry, shoreMaterial);
  beach.receiveShadow = true;
  scene.add(beach);
  const landGeometry = makeRadialGeometry(
    (angle) => poolShapeFactor(angle) + 0.09,
    shoreShapeFactor,
    14,
    160,
    (x, z) => landSurfaceY +
      Math.sin(x * 0.38) * 0.035 +
      Math.sin(z * 0.43) * 0.035 +
      Math.sin((x + z) * 0.68) * 0.025,
    false,
  );
  const land = new THREE.Mesh(landGeometry, grassMaterials[0]);
  land.receiveShadow = true;
  scene.add(land);

  const treeTrunkGeometry = new THREE.CylinderGeometry(0.13, 0.2, 1.35, 12);
  const treeBranchGeometry = new THREE.CylinderGeometry(0.045, 0.105, 0.78, 10);
  const treeLeafGeometries = [
    new THREE.ConeGeometry(0.94, 1.55, 14),
    new THREE.SphereGeometry(0.78, 18, 14),
    new THREE.ConeGeometry(0.68, 1.25, 12),
  ];
  const treeTrunkMaterial = new THREE.MeshStandardMaterial({
    color: 0xb5a18a,
    map: barkTexture,
    bumpMap: barkTexture,
    bumpScale: 0.055,
    roughness: 0.94,
  });
  const treeLeafMaterials = [
    new THREE.MeshStandardMaterial({ color: 0x9cad88, map: leafTexture, roughness: 0.92 }),
    new THREE.MeshStandardMaterial({ color: 0xb3c39a, map: leafTexture, roughness: 0.92 }),
    new THREE.MeshStandardMaterial({ color: 0x849f78, map: leafTexture, roughness: 0.92 }),
  ];
  const foliageGeometry = new THREE.SphereGeometry(1, 10, 8);
  const treeFoliageGeometry = new THREE.ConeGeometry(1, 1, 6);
  const foliageColors = [
    new THREE.Color(0x758f5a),
    new THREE.Color(0x91a56c),
    new THREE.Color(0xa2ad72),
    new THREE.Color(0x637e50),
  ];
  const foliageMaterial = new THREE.MeshStandardMaterial({
    color: 0xffffff,
    map: leafTexture,
    roughness: 0.96,
  });
  const bushGeometry = new THREE.SphereGeometry(0.55, 16, 12);
  const bushMaterials = [
    new THREE.MeshStandardMaterial({ color: 0x789271, map: leafTexture, roughness: 0.94 }),
    new THREE.MeshStandardMaterial({ color: 0x91a17a, map: leafTexture, roughness: 0.94 }),
    new THREE.MeshStandardMaterial({ color: 0x6d8964, map: leafTexture, roughness: 0.94 }),
  ];
  const grassTuftGeometry = new THREE.BufferGeometry();
  const grassTuftPositions: number[] = [];
  for (let blade = 0; blade < 5; blade++) {
    const angle = blade * Math.PI * 0.4;
    const x = Math.cos(angle) * 0.12;
    const z = Math.sin(angle) * 0.12;
    const tipX = Math.cos(angle) * (0.18 + (blade % 2) * 0.07);
    const tipZ = Math.sin(angle) * (0.18 + (blade % 2) * 0.07);
    grassTuftPositions.push(x - 0.035, 0, z, x + 0.035, 0, z, tipX, 0.5 + (blade % 3) * 0.12, tipZ);
  }
  grassTuftGeometry.setAttribute("position", new THREE.Float32BufferAttribute(grassTuftPositions, 3));
  grassTuftGeometry.computeVertexNormals();
  const grassTuftMaterial = new THREE.MeshStandardMaterial({
    color: 0x91a65d,
    roughness: 0.96,
    side: THREE.DoubleSide,
  });
  const groundPlantResources: Array<THREE.BufferGeometry | THREE.Material> = [
    beachGeometry,
    landGeometry,
    ...grassMaterials,
    shoreMaterial,
    shoreTexture,
    grassTexture,
    barkTexture,
    leafTexture,
    furTexture,
    treeTrunkGeometry,
    ...treeLeafGeometries,
    foliageGeometry,
    treeFoliageGeometry,
    treeBranchGeometry,
    treeTrunkMaterial,
    ...treeLeafMaterials,
    foliageMaterial,
    bushGeometry,
    ...bushMaterials,
    grassTuftGeometry,
    grassTuftMaterial,
  ];
  disposableResources.push(...groundPlantResources);
  disposableResources.push(environmentTexture);
  const landObstacles: THREE.Vector3[] = [];
  const shorelineTrees: THREE.Group[] = [];
  const shorelineBushes: THREE.Group[] = [];
  const shorelineGrass: THREE.Mesh[] = [];
  const landArea = landZones.reduce((area, zone) => area + zone.width * zone.depth, 0);
  const landAreaScale = Math.min(1.8, landArea / 330);
  const treeCount = THREE.MathUtils.randInt(Math.round(15 * landAreaScale), Math.round(20 * landAreaScale));
  const bushCount = THREE.MathUtils.randInt(Math.round(28 * landAreaScale), Math.round(36 * landAreaScale));
  const grassTuftCount = THREE.MathUtils.randInt(Math.round(60 * landAreaScale), Math.round(84 * landAreaScale));

  function randomLandPoint(zoneIndex: number, margin = 0.55) {
    const zone = landZones[zoneIndex];
    const angle = THREE.MathUtils.randFloat(zone.angleStart, zone.angleEnd);
    const radialMargin = margin / Math.min(poolWidth, poolDepth) * 2;
    const inner = poolShapeFactor(angle) + 0.06 + radialMargin;
    const outer = Math.max(inner + 0.08, shoreShapeFactor(angle) - radialMargin);
    const factor = THREE.MathUtils.randFloat(inner, outer);
    const position = poolPoint(angle, factor);
    position.y = 0;
    return position;
  }

  function landHeightAt(x: number, z: number) {
    return landSurfaceY +
      Math.sin(x * 0.38) * 0.035 +
      Math.sin(z * 0.43) * 0.035 +
      Math.sin((x + z) * 0.68) * 0.025;
  }

  function addFoliageClusters(
    parent: THREE.Group,
    count: number,
    height: number,
    spread: number,
    verticalRange: [number, number],
    leafScale: number,
    style: "tree" | "bush",
  ) {
    const clusters = new THREE.InstancedMesh(
      style === "tree" ? treeFoliageGeometry : foliageGeometry,
      foliageMaterial,
      count,
    );
    const transform = new THREE.Object3D();
    for (let cluster = 0; cluster < count; cluster++) {
      const angle = Math.random() * Math.PI * 2;
      const radius = Math.sqrt(Math.random()) * height * spread;
      transform.position.set(
        Math.cos(angle) * radius,
        height * THREE.MathUtils.randFloat(...verticalRange),
        Math.sin(angle) * radius,
      );
      transform.rotation.set(
        THREE.MathUtils.randFloatSpread(0.7),
        Math.random() * Math.PI,
        THREE.MathUtils.randFloatSpread(0.7),
      );
      if (style === "tree") {
        const direction = new THREE.Vector3(
          Math.cos(angle) * 0.8,
          THREE.MathUtils.randFloat(-0.05, 0.65),
          Math.sin(angle) * 0.8,
        ).normalize();
        transform.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), direction);
        transform.scale.set(
          height * leafScale * THREE.MathUtils.randFloat(0.75, 1.15),
          height * leafScale * THREE.MathUtils.randFloat(3.2, 5.2),
          height * leafScale * THREE.MathUtils.randFloat(0.75, 1.15),
        );
      } else {
        transform.scale.set(
          height * leafScale * THREE.MathUtils.randFloat(0.75, 1.3),
          height * leafScale * THREE.MathUtils.randFloat(0.65, 1.05),
          height * leafScale * THREE.MathUtils.randFloat(0.75, 1.3),
        );
      }
      transform.updateMatrix();
      clusters.setMatrixAt(cluster, transform.matrix);
      clusters.setColorAt(cluster, foliageColors[Math.floor(Math.random() * foliageColors.length)]);
    }
    clusters.castShadow = true;
    clusters.receiveShadow = true;
    parent.add(clusters);
  }

  for (let index = 0; index < treeCount; index++) {
    const zoneIndex = index % landZones.length;
    const position = randomLandPoint(zoneIndex, 0.8);
    const tree = new THREE.Group();
    const scale = THREE.MathUtils.randFloat(0.72, 1.18);
    const trunk = new THREE.Mesh(treeTrunkGeometry, treeTrunkMaterial);
    trunk.position.y = 0.66;
    tree.add(trunk);
    for (let branch = 0; branch < 3; branch++) {
      const limb = new THREE.Mesh(treeBranchGeometry, treeTrunkMaterial);
      const side = branch % 2 === 0 ? -1 : 1;
      limb.position.set(side * (0.18 + branch * 0.045), 0.72 + branch * 0.19, branch === 1 ? 0.12 : -0.1);
      limb.rotation.z = side * 0.92;
      limb.rotation.x = branch * 0.18;
      tree.add(limb);
    }

    if (Math.random() < 0.22) {
      for (let tier = 0; tier < 4; tier++) {
        const crown = new THREE.Mesh(
          treeLeafGeometries[0],
          treeLeafMaterials[Math.floor(Math.random() * treeLeafMaterials.length)],
        );
        crown.position.y = 1.1 + tier * 0.43;
        crown.scale.setScalar(1 - tier * 0.1);
        tree.add(crown);
      }
    } else {
      const crownClusters = THREE.MathUtils.randInt(12, 17);
      for (let cluster = 0; cluster < crownClusters; cluster++) {
        const angle = Math.random() * Math.PI * 2;
        const radius = Math.random() * 0.56;
        const crown = new THREE.Mesh(
          treeLeafGeometries[1],
          treeLeafMaterials[Math.floor(Math.random() * treeLeafMaterials.length)],
        );
        crown.position.set(
          Math.cos(angle) * radius,
          1.35 + Math.random() * 0.9,
          Math.sin(angle) * radius,
        );
        crown.scale.set(
          THREE.MathUtils.randFloat(0.48, 0.7),
          THREE.MathUtils.randFloat(0.43, 0.64),
          THREE.MathUtils.randFloat(0.48, 0.72),
        );
        tree.add(crown);
      }
    }
    addFoliageClusters(tree, THREE.MathUtils.randInt(70, 95), 2.8, 0.2, [0.52, 0.9], 0.035, "tree");

    tree.position.copy(position);
    tree.position.y = landHeightAt(position.x, position.z);
    tree.rotation.y = Math.random() * Math.PI * 2;
    tree.scale.setScalar(scale);
    tree.traverse((part) => {
      if (part instanceof THREE.Mesh) {
        part.castShadow = true;
        part.receiveShadow = true;
      }
    });
    scene.add(tree);
    shorelineTrees.push(tree);
    landObstacles.push(position.clone());
  }

  for (let index = 0; index < bushCount; index++) {
    const zoneIndex = index % landZones.length;
    const position = randomLandPoint(zoneIndex);
    const bush = new THREE.Group();
    const material = bushMaterials[Math.floor(Math.random() * bushMaterials.length)];
    for (let cluster = 0; cluster < 5; cluster++) {
      const leaf = new THREE.Mesh(bushGeometry, material);
      leaf.position.set(
        (cluster - 2) * 0.28,
        0.28 + (cluster % 2) * 0.14,
        cluster % 2 === 0 ? 0.12 : -0.14,
      );
      leaf.scale.set(
        THREE.MathUtils.randFloat(0.62, 0.85),
        THREE.MathUtils.randFloat(0.55, 0.76),
        THREE.MathUtils.randFloat(0.62, 0.82),
      );
      bush.add(leaf);
    }
    addFoliageClusters(bush, THREE.MathUtils.randInt(18, 25), 1.4, 0.34, [0.18, 0.68], 0.075, "bush");
    bush.position.copy(position);
    bush.position.y = landHeightAt(position.x, position.z);
    bush.rotation.y = Math.random() * Math.PI * 2;
    bush.traverse((part) => {
      if (part instanceof THREE.Mesh) {
        part.castShadow = true;
        part.receiveShadow = true;
      }
    });
    scene.add(bush);
    shorelineBushes.push(bush);
    landObstacles.push(position.clone());
  }

  for (let index = 0; index < grassTuftCount; index++) {
    const zoneIndex = index % landZones.length;
    const position = randomLandPoint(zoneIndex, 0.25);
    const tuft = new THREE.Mesh(grassTuftGeometry, grassTuftMaterial);
    tuft.position.copy(position);
    tuft.position.y = landHeightAt(position.x, position.z) + 0.015;
    tuft.rotation.y = Math.random() * Math.PI * 2;
    tuft.scale.setScalar(THREE.MathUtils.randFloat(0.55, 1.15));
    tuft.castShadow = true;
    scene.add(tuft);
    shorelineGrass.push(tuft);
  }

  type LandAnimalAgent = {
    root: THREE.Group;
    head: THREE.Group;
    tail: THREE.Group;
    species: string;
    zoneIndex: number;
    target: THREE.Vector3;
    legs: THREE.Group[];
    phase: number;
    speed: number;
    currentSpeed: number;
    gaitPhase: number;
    pause: number;
  };
  const landAnimalAgents: LandAnimalAgent[] = [];
  const landAnimalTypes = [
    { name: "rabbit", coat: 0x9b8060, light: 0xd2c29f, ear: 0x9c5e59, scale: 0.76 },
    { name: "fox", coat: 0xb45f32, light: 0xe7bd87, ear: 0x6a3e34, scale: 0.82 },
    { name: "deer", coat: 0x94714c, light: 0xcdb58b, ear: 0x664a36, scale: 0.9 },
    { name: "squirrel", coat: 0x885738, light: 0xd1a66d, ear: 0x794b3a, scale: 0.68 },
  ];
  const animalBodyGeometry = new THREE.SphereGeometry(1, 24, 16);
  const animalHeadGeometry = new THREE.SphereGeometry(1, 20, 14);
  const animalLegGeometry = new THREE.CylinderGeometry(0.055, 0.075, 0.42, 10);
  const animalHoofGeometry = new THREE.CylinderGeometry(0.055, 0.075, 0.09, 8);
  const animalAntlerGeometry = new THREE.CylinderGeometry(0.018, 0.04, 0.42, 8);
  const animalAntlerTipGeometry = new THREE.CylinderGeometry(0.012, 0.027, 0.27, 8);
  const animalEarGeometry = new THREE.SphereGeometry(1, 14, 10);
  const animalTailGeometry = new THREE.SphereGeometry(1, 16, 12);
  const animalNoseGeometry = new THREE.SphereGeometry(0.075, 12, 8);
  const animalEyeGeometry = new THREE.SphereGeometry(0.035, 12, 10);
  const animalHighlightGeometry = new THREE.SphereGeometry(0.012, 8, 8);
  const animalCoatMaterials = landAnimalTypes.map(({ coat }) => new THREE.MeshStandardMaterial({
    color: coat,
    map: furTexture,
    bumpMap: furTexture,
    bumpScale: 0.018,
    roughness: 0.91,
  }));
  const animalLightMaterials = landAnimalTypes.map(({ light }) => new THREE.MeshStandardMaterial({
    color: light,
    map: furTexture,
    bumpMap: furTexture,
    bumpScale: 0.015,
    roughness: 0.88,
  }));
  const animalEarMaterials = landAnimalTypes.map(({ ear }) => new THREE.MeshStandardMaterial({
    color: ear,
    roughness: 0.9,
  }));
  const animalEyeMaterial = new THREE.MeshStandardMaterial({ color: 0x191510, roughness: 0.28 });
  const animalNoseMaterial = new THREE.MeshStandardMaterial({ color: 0x30231c, roughness: 0.42 });
  const animalHoofMaterial = new THREE.MeshStandardMaterial({ color: 0x40342c, roughness: 0.86 });
  const animalEyeHighlightMaterial = new THREE.MeshBasicMaterial({ color: 0xfff4dc });
  const animalResources: Array<THREE.BufferGeometry | THREE.Material> = [
    animalBodyGeometry,
    animalHeadGeometry,
    animalLegGeometry,
    animalHoofGeometry,
    animalAntlerGeometry,
    animalAntlerTipGeometry,
    animalEarGeometry,
    animalTailGeometry,
    animalNoseGeometry,
    animalEyeGeometry,
    animalHighlightGeometry,
    ...animalCoatMaterials,
    ...animalLightMaterials,
    ...animalEarMaterials,
    animalEyeMaterial,
    animalNoseMaterial,
    animalHoofMaterial,
    animalEyeHighlightMaterial,
  ];
  disposableResources.push(...animalResources);

  function randomAnimalPoint(zoneIndex: number) {
    let position = randomLandPoint(zoneIndex, 0.9);
    for (let attempt = 0; attempt < 28; attempt++) {
      position = randomLandPoint(zoneIndex, 0.9);
      if (landObstacles.every((obstacle) => obstacle.distanceTo(position) > 1.2)) break;
    }
    return position;
  }

  function addAnimalPart(
    root: THREE.Group,
    geometry: THREE.BufferGeometry,
    material: THREE.Material,
    position: [number, number, number],
    scale: [number, number, number],
  ) {
    const part = new THREE.Mesh(geometry, material);
    part.position.set(...position);
    part.scale.set(...scale);
    part.castShadow = true;
    part.receiveShadow = true;
    root.add(part);
    return part;
  }

  for (let zoneIndex = 0; zoneIndex < landZones.length; zoneIndex++) {
    const animalType = landAnimalTypes[Math.floor(Math.random() * landAnimalTypes.length)];
    const typeIndex = landAnimalTypes.indexOf(animalType);
    const root = new THREE.Group();
    const head = new THREE.Group();
    const tail = new THREE.Group();
    const coat = animalCoatMaterials[typeIndex];
    const lightCoat = animalLightMaterials[typeIndex];
    const animalScale = animalType.scale * THREE.MathUtils.randFloat(1.05, 1.2);
    const deer = animalType.name === "deer";
    const rabbit = animalType.name === "rabbit";
    const fox = animalType.name === "fox";
    const squirrel = animalType.name === "squirrel";
    const body = addAnimalPart(
      root,
      animalBodyGeometry,
      coat,
      [0, 0.47, 0.02],
      deer ? [0.38, 0.34, 0.76] : rabbit ? [0.36, 0.31, 0.57] : [0.39, 0.34, 0.68],
    );
    if (deer) {
      addAnimalPart(root, animalBodyGeometry, coat, [0, 0.68, -0.32], [0.17, 0.34, 0.2])
        .rotation.x = -0.27;
      addAnimalPart(root, animalBodyGeometry, lightCoat, [0, 0.34, 0.17], [0.25, 0.19, 0.37]);
    } else if (fox) {
      addAnimalPart(root, animalBodyGeometry, lightCoat, [0, 0.34, -0.06], [0.27, 0.17, 0.49]);
    } else if (rabbit) {
      addAnimalPart(root, animalBodyGeometry, coat, [0, 0.4, 0.35], [0.25, 0.25, 0.29]);
      addAnimalPart(root, animalBodyGeometry, lightCoat, [0, 0.31, 0.04], [0.24, 0.16, 0.38]);
    } else {
      addAnimalPart(root, animalBodyGeometry, lightCoat, [0, 0.33, -0.02], [0.22, 0.14, 0.34]);
    }

    head.position.set(0, deer ? 0.91 : rabbit ? 0.73 : 0.76, deer ? -0.48 : -0.48);
    addAnimalPart(head, animalHeadGeometry, coat, [0, 0, 0], deer ? [0.22, 0.25, 0.25] : [0.25, 0.25, 0.27]);
    addAnimalPart(
      head,
      animalHeadGeometry,
      lightCoat,
      [0, fox ? -0.055 : -0.075, fox ? -0.235 : -0.205],
      fox ? [0.15, 0.12, 0.28] : rabbit ? [0.15, 0.12, 0.2] : [0.14, 0.11, 0.17],
    );
    addAnimalPart(head, animalNoseGeometry, animalNoseMaterial, [0, -0.035, fox ? -0.48 : -0.365], [0.78, 0.62, 0.85]);
    for (const side of [-1, 1]) {
      addAnimalPart(
        head,
        animalEyeGeometry,
        animalEyeMaterial,
        [side * 0.2, 0.075, -0.105],
        [deer ? 0.82 : 1, 0.9, 0.72],
      );
      addAnimalPart(
        head,
        animalHighlightGeometry,
        animalEyeHighlightMaterial,
        [side * 0.205 - side * 0.007, 0.087, -0.127],
        [1, 1, 1],
      );
      addAnimalPart(
        head,
        animalNoseGeometry,
        animalEyeMaterial,
        [side * 0.027, -0.025, fox ? -0.5 : -0.38],
        [0.16, 0.13, 0.18],
      );
    }

    if (rabbit) {
      for (const side of [-1, 1]) {
        addAnimalPart(
          head,
          animalEarGeometry,
          coat,
          [side * 0.12, 0.29, 0.035],
          [0.085, 0.36, 0.105],
        ).rotation.z = side * -0.16;
        addAnimalPart(
          head,
          animalEarGeometry,
          animalEarMaterials[typeIndex],
          [side * 0.12, 0.3, -0.015],
          [0.045, 0.27, 0.065],
        ).rotation.z = side * -0.16;
      }
    } else if (deer) {
      for (const side of [-1, 1]) {
        addAnimalPart(
          head,
          animalEarGeometry,
          lightCoat,
          [side * 0.24, 0.07, 0.035],
          [0.19, 0.065, 0.085],
        ).rotation.z = side * 0.35;
        const antler = new THREE.Group();
        antler.position.set(side * 0.12, 0.2, 0.005);
        antler.rotation.z = -side * 0.24;
        addAnimalPart(antler, animalAntlerGeometry, animalEarMaterials[typeIndex], [side * 0.035, 0.19, 0], [1, 1, 1]);
        for (let tine = 0; tine < 2; tine++) {
          const branch = addAnimalPart(
            antler,
            animalAntlerTipGeometry,
            animalEarMaterials[typeIndex],
            [side * (0.1 + tine * 0.025), 0.26 + tine * 0.12, 0],
            [1, 1, 1],
          );
          branch.rotation.z = -side * 0.62;
        }
        head.add(antler);
      }
    } else if (fox) {
      for (const side of [-1, 1]) {
        addAnimalPart(head, animalEarGeometry, coat, [side * 0.15, 0.24, 0.035], [0.11, 0.19, 0.105])
          .rotation.z = side * -0.2;
        addAnimalPart(head, animalEarGeometry, animalEarMaterials[typeIndex], [side * 0.15, 0.25, 0.01], [0.055, 0.12, 0.065])
          .rotation.z = side * -0.2;
      }
    } else {
      addAnimalPart(head, animalEarGeometry, coat, [-0.17, 0.19, 0.02], [0.09, 0.1, 0.08]);
      addAnimalPart(head, animalEarGeometry, coat, [0.17, 0.19, 0.02], [0.09, 0.1, 0.08]);
    }

    root.add(head);
    tail.position.set(0, squirrel ? 0.53 : 0.48, 0.62);
    if (fox) {
      addAnimalPart(tail, animalTailGeometry, coat, [0, 0.02, 0.12], [0.22, 0.23, 0.43]);
      addAnimalPart(tail, animalTailGeometry, lightCoat, [0, -0.015, 0.41], [0.16, 0.17, 0.21]);
      tail.rotation.x = -0.28;
    } else if (squirrel) {
      addAnimalPart(tail, animalTailGeometry, coat, [0, 0.18, 0.02], [0.21, 0.38, 0.2]);
      addAnimalPart(tail, animalTailGeometry, lightCoat, [0, 0.4, 0.015], [0.15, 0.17, 0.16]);
      tail.rotation.x = -0.35;
    } else if (rabbit) {
      addAnimalPart(tail, animalTailGeometry, lightCoat, [0, 0.015, 0.04], [0.13, 0.13, 0.13]);
    } else {
      addAnimalPart(tail, animalTailGeometry, lightCoat, [0, 0.02, 0.02], [0.09, 0.11, 0.13]);
    }
    root.add(tail);

    const legs: THREE.Group[] = [];
    for (const side of [-1, 1]) {
      for (const along of [-1, 1]) {
        const leg = new THREE.Group();
        const legLength = deer ? 1.35 : rabbit && along > 0 ? 0.95 : 1;
        leg.position.set(side * (deer ? 0.23 : 0.24), deer ? 0.34 : 0.3, along * (deer ? 0.39 : 0.39));
        addAnimalPart(leg, animalLegGeometry, coat, [0, -0.04, 0], [deer ? 0.82 : 1, legLength, deer ? 0.82 : 1]);
        if (deer || fox) {
          addAnimalPart(
            leg,
            animalHoofGeometry,
            animalHoofMaterial,
            [0, -0.25 * legLength, 0],
            [deer ? 0.9 : 0.75, 1, deer ? 0.9 : 0.75],
          );
        } else {
          addAnimalPart(leg, animalBodyGeometry, lightCoat, [0, -0.24, -0.015], [0.09, 0.055, 0.12]);
        }
        root.add(leg);
