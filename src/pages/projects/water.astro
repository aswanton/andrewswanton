    const body = new THREE.Mesh(createFishBody(archetype, palette, pattern), bodyMaterial);
    root.add(body);
    const bodyBasePositions = new Float32Array(body.geometry.attributes.position.array);

    const tailDepth = archetype.tailFork;
    const tailGeometry = makeFinGeometry([
      [-0.13, 0, 0],
      [-0.32, 0.18 + tailDepth * 0.24, 0.13],
      [0, 0.08 + tailDepth * 0.08, 0.06],
      [0.32, 0.18 + tailDepth * 0.24, 0.13],
      [0.13, 0, 0],
      [0.32, -0.18 - tailDepth * 0.24, 0.13],
      [0, -0.08 - tailDepth * 0.08, 0.06],
      [-0.32, -0.18 - tailDepth * 0.24, 0.13],
    ]);
    const tailFin = new THREE.Mesh(tailGeometry, finMaterial);
    tailFin.position.z = archetype.bodyLength * 0.47;
    tail.add(tailFin);
    root.add(tail);

    const dorsal = new THREE.Mesh(makeFinGeometry([
      [-0.02, 0.02, -0.34],
      [0, archetype.dorsalHeight, -0.08],
      [0, archetype.dorsalHeight * 0.84, 0.12],
      [0, archetype.dorsalHeight * 0.52, 0.33],
      [0, 0.04, 0.42],
    ]), finMaterial);
    dorsal.position.y = archetype.bodyDepth * 0.17;
    root.add(dorsal);

    const analFin = new THREE.Mesh(makeFinGeometry([
      [0, -0.02, 0.08],
      [0, -archetype.dorsalHeight * 0.48, 0.31],
      [0, -archetype.dorsalHeight * 0.3, 0.43],
      [0, -0.03, 0.48],
    ]), finMaterial);
    root.add(analFin);

    const leftFin = new THREE.Mesh(makeFinGeometry([
      [-0.02, 0, 0],
      [-archetype.finSpan, -0.04, -0.08],
      [-archetype.finSpan * 0.72, -0.13, 0.2],
      [-0.03, -0.08, 0.25],
    ]), paleFinMaterial);
    const rightFin = new THREE.Mesh(leftFin.geometry, paleFinMaterial);
    leftFin.position.set(-0.2, -0.03, -0.08);
    rightFin.position.set(0.2, -0.03, -0.08);
    rightFin.scale.x = -1;
    root.add(leftFin, rightFin);

    for (const side of [-1, 1]) {
      const eye = new THREE.Mesh(new THREE.SphereGeometry(0.052, 12, 10), eyeWhiteMaterial);
      eye.position.set(side * 0.19, 0.075, -archetype.bodyLength * 0.38);
      eye.scale.set(1, 0.9, 0.72);
      root.add(eye);
      fishResourceGeometries.push(eye.geometry);
      const pupil = new THREE.Mesh(new THREE.SphereGeometry(0.028, 10, 8), pupilMaterial);
      pupil.position.set(side * 0.22, 0.082, -archetype.bodyLength * 0.405);
      root.add(pupil);
      fishResourceGeometries.push(pupil.geometry);
    }

    root.scale.setScalar(scale);
    const position = new THREE.Vector3(
      THREE.MathUtils.randFloat(-poolWidth * 0.39, poolWidth * 0.39),
      THREE.MathUtils.randFloat(-1.35, -0.42),
      THREE.MathUtils.randFloat(poolBack + 1.2, poolFront - 1.2),
    );
    keepInsidePool(position, 0.9);
    const velocity = new THREE.Vector3(
      THREE.MathUtils.randFloatSpread(0.45),
      THREE.MathUtils.randFloatSpread(0.08),
      THREE.MathUtils.randFloatSpread(0.45),
    );
    root.position.copy(position);
    root.rotation.y = Math.atan2(velocity.x, -velocity.z);
    root.userData.fishType = archetype.name;
    root.userData.fishColor = `#${new THREE.Color(palette.base).getHexString()}`;
    scene.add(root);

    return {
      root,
      body,
      bodyBasePositions,
      tail,
      leftFin,
      rightFin,
      position,
      velocity,
      archetype,
      phase: Math.random() * Math.PI * 2 + index,
      maxSpeed: THREE.MathUtils.randFloat(0.42, 0.78),
      jumping: false,
    } satisfies FishAgent;
  }

  const shuffledArchetypes = [...fishArchetypes].sort(() => Math.random() - 0.5);
  for (let index = 0; index < fishCount; index++) {
    fishAgents.push(createFish(shuffledArchetypes[index % shuffledArchetypes.length], index));
  }
  disposableResources.push(...fishResourceGeometries, ...fishResourceMaterials);
  const fishTypeSummary = fishAgents.map((fish) => fish.root.userData.fishType).join(", ");
  let visibleTreeCount = treeCount;
  let visibleBushCount = bushCount;

  function updateCanvasDescription() {
    canvas.setAttribute(
      "aria-label",
      `Three-dimensional pool with a randomly generated ${poolWidth.toFixed(1)} by ${poolDepth.toFixed(1)} unit basin and asymmetrical grassy banks. This world has ${visibleTreeCount} trees, ${visibleBushCount} bushes, and four wandering land animals (${landAnimalAgents.map((animal) => animal.species).join(", ")}). The pool has a steerable sailboat, a school of ${fishCount} randomly generated fish (${fishTypeSummary}), an independently moving mallard, and a draggable sphere. Use the arrow keys to sail, drag open water to orbit the camera, or click the water to make a ripple.`,
    );
  }

  updateCanvasDescription();

  function trackModelResources(root: THREE.Object3D) {
    root.traverse((part) => {
      if (!(part instanceof THREE.Mesh)) return;
      disposableResources.push(part.geometry);
      part.castShadow = true;
      part.receiveShadow = true;
      const materials = Array.isArray(part.material) ? part.material : [part.material];
      for (const material of materials) {
        disposableResources.push(material);
        for (const value of Object.values(material)) {
          if (value instanceof THREE.Texture) disposableResources.push(value);
        }
      }
    });
  }

  function createLandscapeInstance(
    source: THREE.Object3D,
    position: THREE.Vector3,
    targetHeight: number,
    rotation: number,
    foliageType: "tree" | "bush",
  ) {
    const model = source.clone(true);
    model.updateMatrixWorld(true);
    const bounds = new THREE.Box3().setFromObject(model);
    const size = bounds.getSize(new THREE.Vector3());
    if (size.y <= 0) throw new Error("A downloaded landscape model has no measurable height.");
    const scale = targetHeight / size.y;
    const center = bounds.getCenter(new THREE.Vector3());
    const groundSink = foliageType === "tree" ? 0.045 : 0.02;
    model.scale.setScalar(scale);
    model.position.set(-center.x * scale, -bounds.min.y * scale, -center.z * scale);

    const instance = new THREE.Group();
    instance.add(model);
    if (foliageType === "tree") {
      addFoliageClusters(instance, THREE.MathUtils.randInt(70, 95), targetHeight, 0.13, [0.64, 0.94], 0.035, "tree");
    } else {
      addFoliageClusters(instance, THREE.MathUtils.randInt(18, 26), targetHeight, 0.38, [0.2, 0.76], 0.085, "bush");
    }
    instance.position.set(
      position.x,
      landHeightAt(position.x, position.z) - groundSink,
      position.z,
    );
    instance.rotation.y = rotation;
    return instance;
  }

  async function loadLandscapeAssets() {
    const loader = new GLTFLoader();
    const results = await Promise.allSettled([
      new HDRLoader().loadAsync("/assets/polyhaven/hdri/autumn_field_puresky_1k.hdr"),
      loader.loadAsync("/assets/polyhaven/models/quiver_tree_01/quiver_tree_01_1k.gltf"),
      loader.loadAsync("/assets/polyhaven/models/shrub_02/shrub_02_1k.gltf"),
      loader.loadAsync("/assets/polyhaven/models/shrub_03/shrub_03_1k.gltf"),
      loader.loadAsync("/assets/polyhaven/models/shrub_04/shrub_04_1k.gltf"),
    ] as const);
    const failures: unknown[] = [];

    const [environmentResult, treeResult, ...shrubResults] = results;
    if (environmentResult.status === "fulfilled") {
      const environment = environmentResult.value;
      environment.mapping = THREE.EquirectangularReflectionMapping;
      scene.environment = environment;
      scene.background = environment;
      scene.backgroundBlurriness = 0.12;
      disposableResources.push(environment);
    } else {
      failures.push(environmentResult.reason);
    }

    if (treeResult.status === "fulfilled") {
      const treeSource = treeResult.value.scene;
      trackModelResources(treeSource);
      const placements = shorelineTrees.map((tree) => ({
        position: tree.position.clone(),
        rotation: tree.rotation.y,
        height: THREE.MathUtils.randFloat(3.2, 5.2),
      }));
      for (const tree of shorelineTrees) scene.remove(tree);
      shorelineTrees.splice(0, shorelineTrees.length);
      for (const placement of placements) {
        const tree = createLandscapeInstance(
          treeSource,
          placement.position,
          placement.height,
          placement.rotation,
          "tree",
        );
        scene.add(tree);
        shorelineTrees.push(tree);
      }
    } else {
      failures.push(treeResult.reason);
    }

    const shrubModels = shrubResults.flatMap((result) => {
      if (result.status === "rejected") {
        failures.push(result.reason);
        return [];
      }
      trackModelResources(result.value.scene);
      return [result.value.scene];
    });
    if (shrubModels.length > 0) {
      for (const bush of shorelineBushes) scene.remove(bush);
      shorelineBushes.splice(0, shorelineBushes.length);
      for (let index = 0; index < bushCount; index++) {
        const position = randomLandPoint(index % landZones.length);
        const source = shrubModels[Math.floor(Math.random() * shrubModels.length)];
        const bush = createLandscapeInstance(
          source,
          position,
          THREE.MathUtils.randFloat(0.65, 1.35),
          Math.random() * Math.PI * 2,
          "bush",
        );
        scene.add(bush);
        shorelineBushes.push(bush);
      }
      visibleBushCount = shorelineBushes.length;
    }

    visibleTreeCount = shorelineTrees.length;
    updateCanvasDescription();
    if (failures.length > 0) {
      console.error("Some CC0 landscape assets could not be loaded; generated scenery remains as a fallback.", failures);
      hint.textContent = "Some detailed landscape assets couldn't load; generated scenery is still active. " + hint.textContent;
    }
  }

  void loadLandscapeAssets().catch((error: unknown) => {
    console.error("The CC0 landscape assets could not be loaded; generated scenery remains active.", error);
    hint.textContent = "Detailed landscape assets couldn't load; generated scenery is still active. " + hint.textContent;
  });

  const sunDirection = new THREE.Vector3(-0.46, 0.42, -0.65).normalize();
  const waterGeometry = makeRadialGeometry(
    () => 0,
    (angle) => poolShapeFactor(angle) + 0.015,
    36,
    192,
    () => 0,
  );
  disposableResources.push(waterGeometry);
  const baseWaterPositions = new Float32Array(waterGeometry.attributes.position.array);
  const surfaceHeightSamples = new Float32Array(waterGeometry.attributes.position.count);
  let waterLevelOffset = 0;
  const water = new Water(waterGeometry, {
    textureWidth: 768,
    textureHeight: 512,
    waterNormals: normalTexture,
    sunDirection,
    sunColor: 0xffe6bd,
    waterColor: 0x174d55,
    distortionScale: 2.8,
    size: waveScale,
    clipBias: 0.002,
    alpha: 0.84,
  });
  water.material.transparent = true;
  water.material.depthWrite = false;
  water.material.uniforms.size.value = waveScale;
  const scrollingNoise = /vec4 getNoise\( vec2 uv \) \{[\s\S]*?\n\t\t\t\t\}/;
  if (!scrollingNoise.test(water.material.fragmentShader)) {
  throw new Error("The water reflection shader no longer matches the ripple texture mapping.");
  }
  water.material.fragmentShader = water.material.fragmentShader.replace(
  scrollingNoise,
  `vec4 getNoise( vec2 uv ) {
      vec2 surfaceUv = fract( uv / 103.0 );
      return texture2D( normalSampler, surfaceUv ) * 2.0;
    }`,
  );
  const waterColorUniform = "uniform vec3 waterColor;";
  const waterOutput = "gl_FragColor = vec4( outgoingLight, alpha );";
  if (!water.material.fragmentShader.includes(waterColorUniform) ||
      !water.material.fragmentShader.includes(waterOutput)) {
    throw new Error("The water shader no longer matches the shoreline fade mapping.");
  }
  water.material.fragmentShader = water.material.fragmentShader
    .replace(waterColorUniform, `${waterColorUniform}
      uniform vec2 poolHalfSize;
      uniform float poolShapePhase;
      uniform float poolShapeStrength;`)
    .replace(waterOutput, `float basinAngle = atan(worldPosition.z / poolHalfSize.y, worldPosition.x / poolHalfSize.x);
      float basinRadius = length(worldPosition.xz / poolHalfSize);
      float basinEdge = 1.0 +
        sin(basinAngle * 2.0 + poolShapePhase) * poolShapeStrength +
        sin(basinAngle * 3.0 - poolShapePhase * 0.7) * poolShapeStrength * 0.32;
      float shorelineFade = 1.0 - smoothstep(basinEdge - 0.015, basinEdge + 0.015, basinRadius);
      gl_FragColor = vec4( outgoingLight, alpha * shorelineFade );`);
  water.material.uniforms.poolHalfSize = {
    value: new THREE.Vector2(poolWidth * 0.5, poolDepth * 0.5),
  };
  water.material.uniforms.poolShapePhase = { value: poolShapePhase };
  water.material.uniforms.poolShapeStrength = { value: poolShapeStrength };
  water.position.set(0, 0, 0);
  scene.add(water);

  let frame = 0;
  let wind = Number(windSlider.value) / 100;
  let elapsed = 0;
  let previousFrameTime = 0;
  let animationFrame = 0;
  let rippleCount = 0;
  let rippleImpactTimeout = 0;
  const visualRipples: Array<{
    geometry: THREE.BufferGeometry;
    material: THREE.MeshBasicMaterial;
    mesh: THREE.Mesh;
    x: number;
    z: number;
    startedAt: number;
  }> = [];
  const raycaster = new THREE.Raycaster();
  const pointer = new THREE.Vector2();
  const dragPlane = new THREE.Plane();
  const cameraDirection = new THREE.Vector3();
  const dragIntersection = new THREE.Vector3();
  const dragOffset = new THREE.Vector3();
  const cameraDragStart = new THREE.Vector2();
  const cameraLastPointer = new THREE.Vector2();
  const cameraLookDirection = new THREE.Vector3();
  let cameraDragging = false;
  let cameraPointerId: number | null = null;
  let cameraDragDistance = 0;
  const previousSpherePosition = new THREE.Vector3();
  const sphereVelocity = new THREE.Vector3();
  let sphereDragging = false;
  let activePointerId: number | null = null;
  let lastDragTime = 0;
  let sphereWasInWater = true;
  let sphereWaterDistance = 0;

  const clamp = (value: number, min: number, max: number) => Math.max(min, Math.min(max, value));
  const wrapUnit = (value: number) => ((value % 1) + 1) % 1;
  function turnToward(current: number, target: number, maxStep: number) {
    const difference = Math.atan2(Math.sin(target - current), Math.cos(target - current));
    return current + clamp(difference, -maxStep, maxStep);
  }
  const rippleRadius = 4;
  const rippleKernel: Array<{ column: number; row: number; positive: number; balancing: number }> = [];
  let positiveRippleWeight = 0;
  let balancingRippleWeight = 0;

  for (let row = -rippleRadius * 3; row <= rippleRadius * 3; row++) {
    for (let column = -rippleRadius * 3; column <= rippleRadius * 3; column++) {
      const distanceSquared = column * column + row * row;
      if (distanceSquared > rippleRadius * rippleRadius * 9) continue;

      const positive = Math.exp(-distanceSquared / (rippleRadius * rippleRadius));
      const balancing = Math.exp(-distanceSquared / (rippleRadius * rippleRadius * 9));
      rippleKernel.push({ column, row, positive, balancing });
      positiveRippleWeight += positive;
      balancingRippleWeight += balancing;
    }
  }
  const rippleBalance = positiveRippleWeight / balancingRippleWeight;

  function sampleWaveHeight(worldX: number, worldZ: number) {
    const textureX = wrapUnit(worldX / repeatDistance) * waveSize;
    const textureY = wrapUnit(worldZ / repeatDistance) * waveSize;
    const x0 = Math.floor(textureX) % waveSize;
    const y0 = Math.floor(textureY) % waveSize;
    const x1 = (x0 + 1) % waveSize;
    const y1 = (y0 + 1) % waveSize;
    const amountX = textureX - Math.floor(textureX);
    const amountY = textureY - Math.floor(textureY);
    const top = THREE.MathUtils.lerp(
      waveData[y0 * waveSize + x0],
      waveData[y0 * waveSize + x1],
      amountX,
    );
    const bottom = THREE.MathUtils.lerp(
      waveData[y1 * waveSize + x0],
      waveData[y1 * waveSize + x1],
      amountX,
    );
    const simulationHeight = THREE.MathUtils.lerp(top, bottom, amountY);
    const phase = elapsed * (0.3 + wind * 0.8);
    const u = textureX / waveSize;
    const v = textureY / waveSize;
    const windSwell =
      Math.sin((u * 3 + v * 2) * Math.PI * 2 + phase) * 0.12 +
      Math.sin((u * 5 - v * 3) * Math.PI * 2 - phase * 0.7) * 0.065;

    return (simulationHeight * 0.42 + windSwell - waterLevelOffset) * poolWaveEdgeFade(worldX, worldZ);
  }

  function setPointerFromClient(clientX: number, clientY: number) {
    const bounds = canvas.getBoundingClientRect();
    pointer.x = ((clientX - bounds.left) / bounds.width) * 2 - 1;
    pointer.y = -((clientY - bounds.top) / bounds.height) * 2 + 1;
    raycaster.setFromCamera(pointer, camera);
  }

  function updateCameraFromDrag(event: PointerEvent) {
    const pointerX = event.clientX;
    const pointerY = event.clientY;
    const deltaX = pointerX - cameraLastPointer.x;
    const deltaY = pointerY - cameraLastPointer.y;
    cameraDragDistance += Math.hypot(deltaX, deltaY);
    cameraLastPointer.set(pointerX, pointerY);

    cameraSpherical.theta -= deltaX * 0.006;
    cameraSpherical.phi = clamp(cameraSpherical.phi - deltaY * 0.006, 0.24, 1.38);
    camera.position.copy(cameraTarget).add(cameraLookDirection.setFromSpherical(cameraSpherical));
    camera.lookAt(cameraTarget);
  }

  function disturbWaterAt(worldX: number, worldZ: number, strength: number) {
    addRipple(
      wrapUnit(worldX / repeatDistance) * waveSize,
      wrapUnit(worldZ / repeatDistance) * waveSize,
      strength,
      false,
    );
  }

  function moveSphereWithPointer(event: PointerEvent) {
    setPointerFromClient(event.clientX, event.clientY);
    if (!raycaster.ray.intersectPlane(dragPlane, dragIntersection)) return;

    const nextPosition = dragIntersection.add(dragOffset);
    nextPosition.x = clamp(nextPosition.x, -poolWidth / 2 + sphereRadius, poolWidth / 2 - sphereRadius);
    nextPosition.y = clamp(
      nextPosition.y,
      poolFloorHeight(nextPosition.x, nextPosition.z) + sphereRadius,
      poolTop + sphereRadius * 3,
    );
    nextPosition.z = clamp(nextPosition.z, poolBack + sphereRadius, poolFront - sphereRadius);
    keepInsidePool(nextPosition, sphereRadius * 0.6);
    nextPosition.y = Math.max(
      nextPosition.y,
      poolFloorHeight(nextPosition.x, nextPosition.z) + sphereRadius,
    );
    const movement = nextPosition.clone().sub(sphere.position);
    const distance = movement.length();
    const deltaTime = Math.max((event.timeStamp - lastDragTime) / 1000, 0.001);

    sphereVelocity.lerp(movement.multiplyScalar(1 / deltaTime), 0.45);
    if (sphereVelocity.length() > 12) sphereVelocity.setLength(12);
    previousSpherePosition.copy(sphere.position);
    sphere.position.copy(nextPosition);
    lastDragTime = event.timeStamp;

    interactWithWater(distance, sphere.position.y < sampleWaveHeight(sphere.position.x, sphere.position.z) + sphereRadius);
  }

  function interactWithWater(distance: number, inWater: boolean) {
    if (inWater) {
      sphereWaterDistance += distance;
      while (sphereWaterDistance >= 0.38) {
        const speed = sphereVelocity.length();
        const speedXZ = Math.hypot(sphereVelocity.x, sphereVelocity.z);
        const trailX = sphere.position.x - (sphereVelocity.x / Math.max(speedXZ, 0.001)) * sphereRadius * 0.72;
        const trailZ = sphere.position.z - (sphereVelocity.z / Math.max(speedXZ, 0.001)) * sphereRadius * 0.72;
        disturbWaterAt(trailX, trailZ, clamp(speed * 0.03, 0.07, 0.32));
        sphereWaterDistance -= 0.38;
      }

      if (!sphereWasInWater) {
        const impactStrength = clamp(Math.abs(sphereVelocity.y) * 0.13, 0.16, 1.1);
        rippleAtWorld(sphere.position.x, sphere.position.z, impactStrength, false);
      }
    } else {
      sphereWaterDistance = 0;
    }

    sphereWasInWater = inWater;
  }

  function updateFloatingSphere(delta: number) {
    if (sphereDragging) return;

    const waterHeight = sampleWaveHeight(sphere.position.x, sphere.position.z);
    const submergedDepth = clamp(waterHeight + sphereRadius - sphere.position.y, 0, sphereRadius * 2);
    const submergedFraction = submergedDepth * submergedDepth * (3 * sphereRadius - submergedDepth) /
      (4 * sphereRadius * sphereRadius * sphereRadius);
    sphereVelocity.y += (-9.8 + submergedFraction * 28) * delta;
    sphereVelocity.y *= Math.exp(
      -(0.3 + submergedFraction * (7.5 + Math.abs(sphereVelocity.y) * 1.1)) * delta,
    );
    const horizontalDrag = Math.exp(-(1.4 + submergedFraction * 3.2) * delta);
    sphereVelocity.x *= horizontalDrag;
    sphereVelocity.z *= horizontalDrag;

    const nextX = sphere.position.x + sphereVelocity.x * delta;
    const nextY = sphere.position.y + sphereVelocity.y * delta;
    const nextZ = sphere.position.z + sphereVelocity.z * delta;
    const minX = -poolWidth / 2 + sphereRadius;
    const maxX = poolWidth / 2 - sphereRadius;
    const minZ = poolBack + sphereRadius;
    const maxZ = poolFront - sphereRadius;

    sphere.position.x = clamp(nextX, minX, maxX);
    sphere.position.y = Math.max(
      nextY,
      poolFloorHeight(sphere.position.x, sphere.position.z) + sphereRadius,
    );
    sphere.position.z = clamp(nextZ, minZ, maxZ);
    keepInsidePool(sphere.position, sphereRadius * 0.6);
    sphere.position.y = Math.max(
      sphere.position.y,
      poolFloorHeight(sphere.position.x, sphere.position.z) + sphereRadius,
    );
    if (nextX < minX || nextX > maxX) sphereVelocity.x *= -0.32;
    if (nextZ < minZ || nextZ > maxZ) sphereVelocity.z *= -0.32;
    if (sphere.position.y <= poolFloorHeight(sphere.position.x, sphere.position.z) + sphereRadius && sphereVelocity.y < 0) {
      sphereVelocity.y = 0;
    }

    const currentWaterHeight = sampleWaveHeight(sphere.position.x, sphere.position.z);
    const inWater = sphere.position.y < currentWaterHeight + sphereRadius;
    interactWithWater(sphere.position.distanceTo(previousSpherePosition), inWater);
    previousSpherePosition.copy(sphere.position);

    sphere.rotation.x += (sphereVelocity.z / sphereRadius) * delta;
    sphere.rotation.z -= (sphereVelocity.x / sphereRadius) * delta;
  }

  function chooseDuckBehavior() {
    const choice = Math.random();
    duckBehavior = choice < 0.26 ? "dabble" : choice < 0.43 ? "rest" : "cruise";
    duckBehaviorTimer = duckBehavior === "dabble"
      ? 2.2 + Math.random() * 2.4
      : duckBehavior === "rest"
        ? 1.2 + Math.random() * 2.1
        : 4.5 + Math.random() * 6;

    if (duckBehavior === "cruise") {
      duckTargetX = THREE.MathUtils.randFloat(-poolWidth * 0.34, poolWidth * 0.34);
      duckTargetZ = THREE.MathUtils.randFloat(poolBack + 2.1, poolFront - 2.1);
    }
  }

  function updateDuck(delta: number) {
    const previousX = duck.position.x;
    const previousZ = duck.position.z;
    duckBehaviorTimer -= delta;
    if (duckBehaviorTimer <= 0) chooseDuckBehavior();

    let desiredX = 0;
    let desiredZ = 0;
    if (duckBehavior === "cruise") {
      let avoidX = 0;
      let avoidZ = 0;
      const sphereDistanceX = duck.position.x - sphere.position.x;
      const sphereDistanceZ = duck.position.z - sphere.position.z;
      const sphereDistance = Math.hypot(sphereDistanceX, sphereDistanceZ);
      const avoidDistance = sphereRadius + 1.2;
      if (sphereDistance < avoidDistance && sphereDistance > 0.001) {
        const avoidance = (avoidDistance - sphereDistance) / avoidDistance;
        avoidX = (sphereDistanceX / sphereDistance) * avoidance;
        avoidZ = (sphereDistanceZ / sphereDistance) * avoidance;
      }

      const targetX = clamp(duckTargetX + avoidX * 2.5, -poolWidth * 0.38, poolWidth * 0.38);
      const targetZ = clamp(duckTargetZ + avoidZ * 2.5, poolBack + 1.7, poolFront - 1.7);
      const directionX = targetX - duck.position.x;
      const directionZ = targetZ - duck.position.z;
      const distance = Math.hypot(directionX, directionZ);
      const cruiseSpeed = Math.min(0.68, distance * 0.3);
      if (distance < 0.65) {
        duckBehaviorTimer = 0;
      } else {
        desiredX = (directionX / distance) * cruiseSpeed;
        desiredZ = (directionZ / distance) * cruiseSpeed;
      }
    } else if (duckBehavior === "dabble") {
      desiredX = duckVelocityX * 0.24;
      desiredZ = duckVelocityZ * 0.24;
    }

    const currentSpeed = Math.hypot(duckVelocityX, duckVelocityZ);
    if (duckBehavior === "cruise" && currentSpeed > 0.05) {
      const avoidanceSpeed = Math.min(0.34, currentSpeed * 0.7);
      const avoidX = duck.position.x - sphere.position.x;
      const avoidZ = duck.position.z - sphere.position.z;
      const avoidDistance = Math.hypot(avoidX, avoidZ);
      if (avoidDistance < sphereRadius + 1.2 && avoidDistance > 0.001) {
        desiredX += (avoidX / avoidDistance) * avoidanceSpeed;
        desiredZ += (avoidZ / avoidDistance) * avoidanceSpeed;
      }
    }

    const desiredSpeed = Math.hypot(desiredX, desiredZ);
    const speedLimit = duckBehavior === "cruise" ? 0.72 : 0.22;
    const targetSpeed = Math.min(desiredSpeed, speedLimit);
    if (desiredSpeed > 0.025) {
      duck.rotation.y = turnToward(duck.rotation.y, Math.atan2(desiredX, -desiredZ), 1.15 * delta);
    }
    const velocity = THREE.MathUtils.damp(currentSpeed, targetSpeed, duckBehavior === "cruise" ? 0.85 : 0.55, delta);
    duckVelocityX = Math.sin(duck.rotation.y) * velocity;
    duckVelocityZ = -Math.cos(duck.rotation.y) * velocity;

    duck.position.x += duckVelocityX * delta;
    duck.position.z += duckVelocityZ * delta;
    keepInsidePool(duck.position, 0.7);
    const minX = -poolWidth / 2 + 1.2;
    const maxX = poolWidth / 2 - 1.2;
    const minZ = poolBack + 1.2;
    const maxZ = poolFront - 1.2;
    if (duck.position.x < minX || duck.position.x > maxX) {
      duck.position.x = clamp(duck.position.x, minX, maxX);
      duckVelocityX = 0;
      duckBehaviorTimer = 0;
    }
    if (duck.position.z < minZ || duck.position.z > maxZ) {
      duck.position.z = clamp(duck.position.z, minZ, maxZ);
      duckVelocityZ = 0;
      duckBehaviorTimer = 0;
    }
    duckHeadDip = THREE.MathUtils.damp(duckHeadDip, duckBehavior === "dabble" ? 1 : 0, 1.7, delta);
    duck.position.y = sampleWaveHeight(duck.position.x, duck.position.z) + 0.035 +
      Math.sin(elapsed * 1.7 + duck.position.x) * 0.022 +
      Math.sin(elapsed * 3.8 + duck.position.z) * 0.008;
    duck.rotation.x = Math.sin(elapsed * 1.5 + duck.position.z) * 0.016;
    duck.rotation.z = THREE.MathUtils.clamp(-duckVelocityX * 0.055, -0.035, 0.035) +
      Math.sin(elapsed * 1.1 + duck.position.x) * 0.012;
    duckHead.position.y = 0.39 - duckHeadDip * 0.32;
    duckHead.rotation.x = -duckHeadDip * 0.85 + Math.sin(elapsed * 1.2) * 0.025;
    duckHead.rotation.z = Math.sin(elapsed * 0.65 + duck.position.x) * 0.028;
    duckWings[0].rotation.z = Math.sin(elapsed * 1.7) * 0.012;
    duckWings[1].rotation.z = -Math.sin(elapsed * 1.7) * 0.012;
    const paddle = Math.sin(elapsed * (duckBehavior === "cruise" ? 5.4 : 2.7)) *
      Math.min(velocity / 0.28, duckBehavior === "dabble" ? 0.45 : 1);
    duckFeet[0].rotation.y = paddle * 0.48;
    duckFeet[1].rotation.y = -paddle * 0.48;

    const distance = Math.hypot(duck.position.x - previousX, duck.position.z - previousZ);
    duckWakeTimer += delta;
    if (duckWakeTimer >= 0.7 && distance > 0.001) {
      const wakeX = duck.position.x + Math.sin(duck.rotation.y) * 0.72;
      const wakeZ = duck.position.z + Math.cos(duck.rotation.y) * 0.72;
      disturbWaterAt(wakeX, wakeZ, clamp(distance * 0.18, 0.035, 0.08));
      duckWakeTimer = 0;
    }
  }

  function updateSailboat(delta: number) {
    const throttle = Number(sailboatKeys.has("ArrowUp")) - Number(sailboatKeys.has("ArrowDown"));
    const steering = Number(sailboatKeys.has("ArrowRight")) - Number(sailboatKeys.has("ArrowLeft"));
    const windPower = 0.3 + wind * 0.7;
    sailboatForward.set(Math.sin(sailboat.rotation.y), 0, -Math.cos(sailboat.rotation.y));
    const forwardSpeed = sailboatVelocity.dot(sailboatForward);
    const steeringAuthority = 0.08 + Math.min(Math.abs(forwardSpeed) / 2, 1) * 1.1;
    const targetTurnRate = steering * steeringAuthority * Math.sign(forwardSpeed || 1);
    sailboatTurnRate = THREE.MathUtils.damp(sailboatTurnRate, targetTurnRate, 4.5, delta);
    sailboat.rotation.y += sailboatTurnRate * delta;
    rudderGroup.rotation.y = -steering * 0.42;

    sailboatForward.set(Math.sin(sailboat.rotation.y), 0, -Math.cos(sailboat.rotation.y));
    sailboatVelocity.addScaledVector(sailboatForward, throttle * 2.2 * windPower * delta);
    sailboatForwardVelocity.copy(sailboatForward).multiplyScalar(sailboatVelocity.dot(sailboatForward));
    sailboatLateralVelocity.copy(sailboatVelocity).sub(sailboatForwardVelocity);
    sailboatVelocity.addScaledVector(sailboatLateralVelocity, -Math.min(delta * 4.5, 1));
    sailboatVelocity.multiplyScalar(Math.exp(-0.34 * delta));

    const currentForwardSpeed = sailboatVelocity.dot(sailboatForward);
    const forwardLimit = 1.15 + wind * 1.9;
    if (currentForwardSpeed > forwardLimit) {
      sailboatVelocity.addScaledVector(sailboatForward, forwardLimit - currentForwardSpeed);
    } else if (currentForwardSpeed < -1.05) {
      sailboatVelocity.addScaledVector(sailboatForward, -1.05 - currentForwardSpeed);
    }

    const nextX = sailboat.position.x + sailboatVelocity.x * delta;
    const nextZ = sailboat.position.z + sailboatVelocity.z * delta;
    const minX = -poolWidth / 2 + 1.1;
    const maxX = poolWidth / 2 - 1.1;
    const minZ = poolBack + 1.1;
    const maxZ = poolFront - 1.1;
    sailboat.position.x = clamp(nextX, minX, maxX);
    sailboat.position.z = clamp(nextZ, minZ, maxZ);
    keepInsidePool(sailboat.position, 0.8);
    if (sailboat.position.x !== nextX) {
      sailboatVelocity.x = 0;
      sailboatVelocity.z *= 0.45;
    }
    if (sailboat.position.z !== nextZ) {
      sailboatVelocity.z = 0;
      sailboatVelocity.x *= 0.45;
    }

    sailboat.position.y = sampleWaveHeight(sailboat.position.x, sailboat.position.z) +
      Math.sin(elapsed * 1.9 + sailboat.position.z) * 0.024;
    sailboat.rotation.x = Math.sin(elapsed * 1.3 + sailboat.position.x) * 0.012;
    sailboat.rotation.z = -sailboatTurnRate * Math.min(Math.abs(forwardSpeed), 1.5) * 0.025 +
      Math.sin(elapsed * 1.1 + sailboat.position.z) * 0.012;

    sailboatWakeTimer += delta;
    const speed = sailboatVelocity.length();
    if (sailboatWakeTimer >= 0.38 && speed > 0.16) {
      const wakeX = sailboat.position.x - sailboatVelocity.x / speed * 0.82;
      const wakeZ = sailboat.position.z - sailboatVelocity.z / speed * 0.82;
      disturbWaterAt(wakeX, wakeZ, clamp(speed * 0.09, 0.04, 0.19));
      sailboatWakeTimer = 0;
    }
  }

  function updateShoreline(delta: number) {
    for (let index = 0; index < shorelineTrees.length; index++) {
      const gust = Math.sin(elapsed * 0.72 + index * 1.7);
      shorelineTrees[index].rotation.z = gust * (0.003 + wind * 0.075);
      shorelineTrees[index].rotation.x = Math.sin(elapsed * 0.54 + index * 2.3) * wind * 0.018;
    }
    for (let index = 0; index < shorelineBushes.length; index++) {
      const gust = Math.sin(elapsed * 1.15 + index * 2.1);
      shorelineBushes[index].rotation.z = gust * (0.006 + wind * 0.12);
      shorelineBushes[index].rotation.x = Math.sin(elapsed * 0.9 + index * 1.4) * wind * 0.035;
    }
    for (let index = 0; index < shorelineGrass.length; index++) {
      shorelineGrass[index].rotation.z =
        Math.sin(elapsed * 2.4 + index * 2.1) * (0.025 + wind * 0.065);
    }

    for (const animal of landAnimalAgents) {
      const { root, head, tail, legs, target, phase, speed } = animal;
      const dx = target.x - root.position.x;
      const dz = target.z - root.position.z;
      const distance = Math.hypot(dx, dz);

      if (distance < 0.2) {
        animal.target.copy(randomAnimalPoint(animal.zoneIndex));
        animal.pause = THREE.MathUtils.randFloat(1.1, 3.8);
      }

      if (animal.pause > 0) {
        animal.pause = Math.max(0, animal.pause - delta);
        animal.currentSpeed = THREE.MathUtils.damp(animal.currentSpeed, 0, 2.2, delta);
        root.position.y = landHeightAt(root.position.x, root.position.z);
        root.rotation.x = Math.sin(elapsed * 1.5 + phase) * 0.01;
        head.rotation.x = Math.sin(elapsed * 1.3 + phase) * 0.025;
        tail.rotation.y = Math.sin(elapsed * 1.8 + phase) * (animal.species === "squirrel" ? 0.15 : 0.07);
        for (const leg of legs) {
          leg.rotation.x = THREE.MathUtils.damp(leg.rotation.x, 0, 5, delta);
        }
        continue;
      }

      const desiredHeading = Math.atan2(-dx, -dz);
      const headingDifference = Math.atan2(
        Math.sin(desiredHeading - root.rotation.y),
        Math.cos(desiredHeading - root.rotation.y),
      );
      root.rotation.y = turnToward(root.rotation.y, desiredHeading, 1.8 * delta);
      const turnFactor = clamp(1 - Math.abs(headingDifference) / Math.PI * 0.55, 0.4, 1);
      const distanceFactor = clamp(distance / 0.65, 0.25, 1);
      animal.currentSpeed = THREE.MathUtils.damp(
        animal.currentSpeed,
        speed * turnFactor * distanceFactor,
        1.6,
        delta,
      );
      const step = Math.min(animal.currentSpeed * delta, distance);
      if (distance > 0.001) {
        root.position.x -= Math.sin(root.rotation.y) * step;
        root.position.z -= Math.cos(root.rotation.y) * step;
      }
      animal.gaitPhase += delta * (7 + animal.currentSpeed * 8);
      const stride = Math.sin(animal.gaitPhase) * clamp(animal.currentSpeed / speed, 0, 1);
      root.position.y = landHeightAt(root.position.x, root.position.z) +
        Math.abs(Math.sin(animal.gaitPhase * 2)) * Math.min(animal.currentSpeed * 0.035, 0.018);
      root.rotation.x = Math.sin(animal.gaitPhase * 2) * Math.min(animal.currentSpeed * 0.025, 0.012);
      head.rotation.x = Math.sin(animal.gaitPhase * 2 + phase) * 0.035;
      tail.rotation.y = Math.sin(animal.gaitPhase + phase) * (animal.species === "squirrel" ? 0.2 : 0.1);
      const gait = stride * Math.min(speed * 1.1, 0.5);
      legs[0].rotation.x = gait;
      legs[1].rotation.x = -gait;
      legs[2].rotation.x = -gait;
      legs[3].rotation.x = gait;
    }
  }

  function resolveWaterCollision(
    firstPosition: THREE.Vector3,
    firstVelocity: THREE.Vector3,
    firstRadius: number,
    firstMass: number,
    secondPosition: THREE.Vector3,
    secondVelocity: THREE.Vector3,
    secondRadius: number,
    secondMass: number,
    restitution: number,
  ) {
    collisionOffset.set(secondPosition.x - firstPosition.x, 0, secondPosition.z - firstPosition.z);
    const distance = collisionOffset.length();
    const overlap = firstRadius + secondRadius - distance;
    if (overlap <= 0) return 0;

    if (distance > 0.0001) {
      collisionNormal.copy(collisionOffset).multiplyScalar(1 / distance);
    } else {
      collisionNormal.set(1, 0, 0);
    }

    const firstInverseMass = 1 / firstMass;
    const secondInverseMass = 1 / secondMass;
    const inverseMassSum = firstInverseMass + secondInverseMass;
    firstPosition.addScaledVector(collisionNormal, -overlap * firstInverseMass / inverseMassSum);
    secondPosition.addScaledVector(collisionNormal, overlap * secondInverseMass / inverseMassSum);

    const closingSpeed =
      (secondVelocity.x - firstVelocity.x) * collisionNormal.x +
      (secondVelocity.z - firstVelocity.z) * collisionNormal.z;
    if (closingSpeed >= 0) return 0;

    const impulse = -(1 + restitution) * closingSpeed / inverseMassSum;
    firstVelocity.addScaledVector(collisionNormal, -impulse * firstInverseMass);
    secondVelocity.addScaledVector(collisionNormal, impulse * secondInverseMass);
    return impulse;
  }

  function sphereRadiusAtHeight(colliderHeight: number) {
    const verticalDistance = Math.abs(sphere.position.y - colliderHeight);
    if (verticalDistance >= sphereRadius) return 0;
    return Math.sqrt(sphereRadius * sphereRadius - verticalDistance * verticalDistance);
  }

  function updateWaterCollisions() {
    duckPlanarVelocity.set(duckVelocityX, 0, duckVelocityZ);
    const boatDuckImpulse = resolveWaterCollision(
      sailboat.position,
      sailboatVelocity,
      0.78,
      1.5,
      duck.position,
      duckPlanarVelocity,
      0.5,
      0.55,
      0.14,
    );
    let collisionImpulse = boatDuckImpulse;
    let impactX = (sailboat.position.x + duck.position.x) * 0.5;
    let impactZ = (sailboat.position.z + duck.position.z) * 0.5;

    let boatBallImpulse = 0;
    let duckBallImpulse = 0;
    if (!sphereDragging) {
      const boatBallRadius = sphereRadiusAtHeight(sailboat.position.y + 0.34);
      if (boatBallRadius > 0) {
        boatBallImpulse = resolveWaterCollision(
          sailboat.position,
          sailboatVelocity,
          0.78,
          1.5,
          sphere.position,
          sphereVelocity,
          boatBallRadius,
          3.2,
          0.2,
        );
      }

      if (boatBallImpulse > collisionImpulse) {
        collisionImpulse = boatBallImpulse;
        impactX = (sailboat.position.x + sphere.position.x) * 0.5;
        impactZ = (sailboat.position.z + sphere.position.z) * 0.5;
      }

      const duckBallRadius = sphereRadiusAtHeight(duck.position.y + 0.12);
      if (duckBallRadius > 0) {
        duckBallImpulse = resolveWaterCollision(
          duck.position,
          duckPlanarVelocity,
          0.5,
          0.55,
          sphere.position,
          sphereVelocity,
          duckBallRadius,
          3.2,
          0.12,
        );
      }

      if (duckBallImpulse > collisionImpulse) {
        collisionImpulse = duckBallImpulse;
        impactX = (duck.position.x + sphere.position.x) * 0.5;
        impactZ = (duck.position.z + sphere.position.z) * 0.5;
      }

      sphere.position.x = clamp(sphere.position.x, -poolWidth / 2 + sphereRadius, poolWidth / 2 - sphereRadius);
      sphere.position.z = clamp(sphere.position.z, poolBack + sphereRadius, poolFront - sphereRadius);
    }

    sailboat.position.x = clamp(sailboat.position.x, -poolWidth / 2 + 1.1, poolWidth / 2 - 1.1);
    sailboat.position.z = clamp(sailboat.position.z, poolBack + 1.1, poolFront - 1.1);
    duck.position.x = clamp(duck.position.x, -poolWidth * 0.36, poolWidth * 0.36);
    duck.position.z = clamp(duck.position.z, poolBack + 1.5, poolFront - 1.5);
    keepInsidePool(sailboat.position, 0.8);
    keepInsidePool(duck.position, 0.7);
    keepInsidePool(sphere.position, sphereRadius * 0.6);
    duckVelocityX = duckPlanarVelocity.x;
    duckVelocityZ = duckPlanarVelocity.z;

    if (collisionImpulse > 0.18) {
      disturbWaterAt(impactX, impactZ, clamp(collisionImpulse * 0.12, 0.08, 0.48));
    }
  }

  const fishDesired = new THREE.Vector3();
  const fishSeparation = new THREE.Vector3();
  const fishAlignment = new THREE.Vector3();
  const fishCohesion = new THREE.Vector3();
  const fishOffset = new THREE.Vector3();
  const fishAvoidance = new THREE.Vector3();

  function updateFish(delta: number) {
    fishJumpTimer -= delta;
    if (fishJumpTimer <= 0 && !fishAgents.some((fish) => fish.jumping)) {
      const candidates = fishAgents.filter((fish) => fish.position.y > -2.1);
      if (candidates.length > 0) {
        const fish = candidates[Math.floor(Math.random() * candidates.length)];
        const waterHeight = sampleWaveHeight(fish.position.x, fish.position.z);
        fish.position.y = Math.min(fish.position.y, waterHeight - 0.08);
        fish.velocity.y = Math.sqrt(2 * 9.8 * (waterHeight + THREE.MathUtils.randFloat(0.4, 0.8) - fish.position.y));
        fish.jumping = true;
        fishJumpTimer = THREE.MathUtils.randFloat(24, 48);
      } else {
        fishJumpTimer = 5;
      }
    }

    for (let index = 0; index < fishAgents.length; index++) {
      const fish = fishAgents[index];
      const { position, velocity, maxSpeed, phase } = fish;
      let horizontalSpeed = Math.hypot(velocity.x, velocity.z);
      if (fish.jumping) {
        velocity.y -= 9.8 * delta;
        position.addScaledVector(velocity, delta);
        position.x = clamp(position.x, -poolWidth / 2 + 0.85, poolWidth / 2 - 0.85);
        position.z = clamp(position.z, poolBack + 0.85, poolFront - 0.85);
        keepInsidePool(position, 0.55);
        const waterHeight = sampleWaveHeight(position.x, position.z);
        if (velocity.y < 0 && position.y <= waterHeight) {
          position.y = waterHeight - 0.18;
          velocity.y = 0;
          fish.jumping = false;
          rippleAtWorld(position.x, position.z, THREE.MathUtils.randFloat(0.38, 0.66), false);
        }
        fish.root.position.copy(position);
        horizontalSpeed = Math.hypot(velocity.x, velocity.z);
        fish.root.rotation.x = Math.atan2(velocity.y, Math.max(horizontalSpeed, 0.01));
      } else {
      fishDesired.set(
        Math.sin(elapsed * 0.23 + phase) * 0.55 + Math.cos(elapsed * 0.11 + phase) * 0.28,
        Math.sin(elapsed * 0.19 + phase * 1.7) * 0.12,
        Math.cos(elapsed * 0.2 + phase) * 0.55 + Math.sin(elapsed * 0.13 + phase * 0.8) * 0.28,
      );
      fishSeparation.set(0, 0, 0);
      fishAlignment.set(0, 0, 0);
      fishCohesion.set(0, 0, 0);
      let schoolmates = 0;

      for (let otherIndex = 0; otherIndex < fishAgents.length; otherIndex++) {
        if (otherIndex === index) continue;
        const other = fishAgents[otherIndex];
        fishOffset.subVectors(position, other.position);
        const distance = fishOffset.length();
        if (distance < 1.35 && distance > 0.001) {
          fishSeparation.addScaledVector(fishOffset, (1.35 - distance) / (1.35 * distance));
        }
        if (distance < 4.2) {
          fishAlignment.add(other.velocity);
          fishCohesion.add(other.position);
          schoolmates++;
        }
      }

      if (schoolmates > 0) {
        fishAlignment.multiplyScalar(1 / schoolmates);
        fishCohesion.multiplyScalar(1 / schoolmates).sub(position);
        fishDesired.addScaledVector(fishAlignment, 0.55);
        fishDesired.addScaledVector(fishCohesion, 0.16);
      }
      fishDesired.addScaledVector(fishSeparation, 1.2);

      for (const obstacle of [sphere.position, duck.position]) {
        fishAvoidance.subVectors(position, obstacle);
        const distance = fishAvoidance.length();
        const safeDistance = obstacle === sphere.position ? sphereRadius + 0.9 : 1.25;
        if (distance < safeDistance && distance > 0.001) {
          fishDesired.addScaledVector(fishAvoidance, (safeDistance - distance) * 0.9 / distance);
        }
      }

      const minX = -poolWidth / 2 + 0.85;
      const maxX = poolWidth / 2 - 0.85;
      const minY = -2.55;
      const maxY = -0.48;
      const minZ = poolBack + 0.85;
      const maxZ = poolFront - 0.85;
      if (position.x < minX + 1.6) fishDesired.x += (minX + 1.6 - position.x) * 0.55;
      if (position.x > maxX - 1.6) fishDesired.x -= (position.x - (maxX - 1.6)) * 0.55;
      if (position.y < minY + 0.55) fishDesired.y += (minY + 0.55 - position.y) * 0.7;
      if (position.y > maxY - 0.55) fishDesired.y -= (position.y - (maxY - 0.55)) * 0.7;
      if (position.z < minZ + 1.6) fishDesired.z += (minZ + 1.6 - position.z) * 0.55;
      if (position.z > maxZ - 1.6) fishDesired.z -= (position.z - (maxZ - 1.6)) * 0.55;
      if (fishDesired.lengthSq() > 0.001) fishDesired.setLength(maxSpeed);

      const desiredHorizontalSpeed = Math.hypot(fishDesired.x, fishDesired.z);
      if (desiredHorizontalSpeed > 0.001) {
        fish.root.rotation.y = turnToward(
          fish.root.rotation.y,
          Math.atan2(fishDesired.x, -fishDesired.z),
          1.15 * delta,
        );
      }
      const swimSpeed = THREE.MathUtils.damp(
        Math.hypot(velocity.x, velocity.z),
        maxSpeed,
        0.75,
        delta,
      );
      velocity.x = Math.sin(fish.root.rotation.y) * swimSpeed;
      velocity.z = -Math.cos(fish.root.rotation.y) * swimSpeed;
      velocity.y = THREE.MathUtils.damp(velocity.y, clamp(fishDesired.y * 0.14, -0.12, 0.12), 0.75, delta);

      position.addScaledVector(velocity, delta);
      position.x = clamp(position.x, minX, maxX);
      position.y = clamp(position.y, minY, maxY);
      position.z = clamp(position.z, minZ, maxZ);
      keepInsidePool(position, 0.55);
      fish.root.position.copy(position);

      horizontalSpeed = Math.hypot(velocity.x, velocity.z);
      fish.root.rotation.x = THREE.MathUtils.damp(
        fish.root.rotation.x,
        Math.atan2(velocity.y, Math.max(horizontalSpeed, 0.01)),
        1.8,
        delta,
      );
      fish.root.rotation.z = Math.sin(elapsed * 2.4 + phase) * 0.025 +
        THREE.MathUtils.clamp(-velocity.x * 0.08, -0.06, 0.06);
      }

      const swimFactor = Math.min(horizontalSpeed / maxSpeed, 1);
      const stroke = Math.sin(elapsed * (7.5 + maxSpeed * 2) + phase) * (0.12 + swimFactor * 0.42);
      const bodyPositions = fish.body.geometry.attributes.position;
      const bodyLength = fish.archetype.bodyLength;
      const bodyFlex = swimFactor * 0.07;
      for (let vertex = 0; vertex < bodyPositions.count; vertex++) {
        const baseIndex = vertex * 3;
        const z = fish.bodyBasePositions[baseIndex + 2];
        const tailWeight = Math.max(0, z / bodyLength + 0.5) ** 2;
        const wave = Math.sin(elapsed * 7.5 + phase - z * 4) - Math.sin(elapsed * 7.5 + phase);
        bodyPositions.setX(vertex, fish.bodyBasePositions[baseIndex] + wave * bodyFlex * tailWeight);
      }
      bodyPositions.needsUpdate = true;
      fish.body.geometry.computeVertexNormals();
      fish.tail.position.x = stroke * 0.12;
      fish.tail.rotation.y = stroke;
      fish.leftFin.rotation.z = Math.sin(elapsed * 5.4 + phase) * 0.16;
      fish.rightFin.rotation.z = -Math.sin(elapsed * 5.4 + phase) * 0.16;
      fish.leftFin.rotation.x = Math.cos(elapsed * 5.4 + phase) * 0.1;
      fish.rightFin.rotation.x = Math.cos(elapsed * 5.4 + phase + Math.PI) * 0.1;
    }
  }

  function updateWaterSurface() {
    const positions = waterGeometry.attributes.position;
    let heightSum = 0;

    for (let index = 0; index < positions.count; index++) {
      const worldX = baseWaterPositions[index * 3];
      const worldZ = baseWaterPositions[index * 3 + 2] + water.position.z;
      const height = sampleWaveHeight(worldX, worldZ);
      surfaceHeightSamples[index] = height;
      heightSum += height;
    }

    const meanHeight = heightSum / positions.count;
    waterLevelOffset += meanHeight;
    for (let index = 0; index < positions.count; index++) {
      positions.setY(index, surfaceHeightSamples[index] - meanHeight);
    }

    positions.needsUpdate = true;
    waterGeometry.computeVertexNormals();
  }

  function resize() {
    const bounds = stage.getBoundingClientRect();
    if (!bounds.width || !bounds.height) return;

    const pixelRatio = Math.min(window.devicePixelRatio || 1, 1.5);
    renderer.setPixelRatio(pixelRatio);
    renderer.setSize(bounds.width, bounds.height, false);
    camera.aspect = bounds.width / bounds.height;
    camera.updateProjectionMatrix();
  }

  function addRipple(x: number, y: number, strength: number, announce = true) {
    for (const sample of rippleKernel) {
      const wrappedX = (Math.round(x + sample.column) + waveSize) % waveSize;
      const wrappedY = (Math.round(y + sample.row) + waveSize) % waveSize;
      const index = wrappedY * waveSize + wrappedX;
      waveData[index] += strength * (sample.positive - rippleBalance * sample.balancing);
    }

    if (announce) {
      rippleCount++;
      hint.textContent = `Ripple ${rippleCount} added — tap again or change the wind`;
    }
  }

  function addRippleRing(x: number, z: number) {
    const geometry = new THREE.RingGeometry(0.84, 1, 80);
    const material = new THREE.MeshBasicMaterial({
      color: 0xbaf8ff,
      transparent: true,
      opacity: 0.72,
      depthWrite: false,
      side: THREE.DoubleSide,
    });
    const mesh = new THREE.Mesh(geometry, material);
    mesh.rotation.x = -Math.PI / 2;
    mesh.renderOrder = 3;
    scene.add(mesh);
    visualRipples.push({ geometry, material, mesh, x, z, startedAt: elapsed });

    while (visualRipples.length > 24) {
      const oldest = visualRipples.shift();
      if (!oldest) continue;
      scene.remove(oldest.mesh);
      oldest.geometry.dispose();
      oldest.material.dispose();
    }

    disposableResources.push(geometry, material);
  }

  function rippleAtWorld(x: number, z: number, strength: number, announce = true, impactPosition?: { x: number; y: number }) {
    const textureX = Math.floor(wrapUnit(x / repeatDistance) * waveSize);
    const textureY = Math.floor(wrapUnit(z / repeatDistance) * waveSize);
    addRipple(textureX, textureY, strength, announce);
    addRippleRing(x, z);
    if (announce && impactPosition) showRippleImpact(impactPosition.x, impactPosition.y);
  }

  function showRippleImpact(clientX: number, clientY: number) {
    const stageBounds = stage.getBoundingClientRect();

    rippleImpact.style.left = `${clientX - stageBounds.left}px`;
    rippleImpact.style.top = `${clientY - stageBounds.top}px`;
    rippleImpact.classList.remove("active");
    void rippleImpact.offsetWidth;
    rippleImpact.classList.add("active");
    window.clearTimeout(rippleImpactTimeout);
    rippleImpactTimeout = window.setTimeout(() => rippleImpact.classList.remove("active"), 1400);
  }

  function updateRippleRings() {
    for (let index = visualRipples.length - 1; index >= 0; index--) {
      const ripple = visualRipples[index];
      const age = elapsed - ripple.startedAt;
      const lifetime = 1.8;
      if (age >= lifetime) {
        scene.remove(ripple.mesh);
        ripple.geometry.dispose();
        ripple.material.dispose();
        visualRipples.splice(index, 1);
        continue;
      }

      const progress = age / lifetime;
      const radius = 0.24 + progress * 2.7;
      ripple.mesh.position.set(ripple.x, sampleWaveHeight(ripple.x, ripple.z) + 0.13, ripple.z);
      ripple.mesh.scale.setScalar(radius);
      ripple.material.opacity = 0.85 * (1 - progress) ** 1.4;
    }
  }

  function updateWaves() {
    const damping = 0.016 + wind * 0.012;

    for (let y = 0; y < waveSize; y++) {
      const above = ((y - 1 + waveSize) % waveSize) * waveSize;
      const below = ((y + 1) % waveSize) * waveSize;
      const row = y * waveSize;

      for (let x = 0; x < waveSize; x++) {
        const left = row + (x - 1 + waveSize) % waveSize;
        const right = row + (x + 1) % waveSize;
        const index = row + x;
        const current = waveData[index];
        const laplacian =
          waveData[left] +
          waveData[right] +
          waveData[above + x] +
          waveData[below + x] -
          4 * current;

        nextWaveData[index] =
          2 * current -
          previousWaveData[index] +
          0.22 * laplacian -
          damping * (current - previousWaveData[index]);
      }
    }

    const oldPrevious = previousWaveData;
    previousWaveData.set(waveData);
    waveData.set(nextWaveData);
    nextWaveData.set(oldPrevious);

    // Keep the periodic wave field at its baseline so impulses cannot add water volume.
    let currentMean = 0;
    let previousMean = 0;
    for (let index = 0; index < waveData.length; index++) {
      currentMean += waveData[index];
      previousMean += previousWaveData[index];
    }
    currentMean /= waveData.length;
    previousMean /= previousWaveData.length;
    for (let index = 0; index < waveData.length; index++) {
      waveData[index] -= currentMean;
      previousWaveData[index] -= previousMean;
    }
  }

  function updateNormalTexture() {
    const phase = elapsed * (0.3 + wind * 0.8);
    const surfaceHeight = (x: number, y: number) => {
      const sampleX = (x + waveSize) % waveSize;
      const sampleY = (y + waveSize) % waveSize;
      const u = sampleX / waveSize;
      const v = sampleY / waveSize;
      const index = sampleY * waveSize + sampleX;

      return waveData[index] * 0.42 +
        Math.sin((u * 3 + v * 2) * Math.PI * 2 + phase) * 0.12 +
        Math.sin((u * 5 - v * 3) * Math.PI * 2 - phase * 0.7) * 0.065;
    };

    for (let y = 0; y < waveSize; y++) {
      const row = y * waveSize;
      const above = ((y - 1 + waveSize) % waveSize) * waveSize;
      const below = ((y + 1) % waveSize) * waveSize;

      for (let x = 0; x < waveSize; x++) {
        const left = (x - 1 + waveSize) % waveSize;
        const right = (x + 1) % waveSize;
        const index = row + x;
        const slopeX = (surfaceHeight(right, y) - surfaceHeight(left, y)) * 1.15;
        const slopeZ = (surfaceHeight(x, y + 1) - surfaceHeight(x, y - 1)) * 1.15;
        const normalX = clamp(-slopeX, -0.95, 0.95);
        const normalZ = clamp(-slopeZ, -0.95, 0.95);
        const normalY = Math.sqrt(Math.max(0.01, 1 - normalX * normalX - normalZ * normalZ));
        const pixel = index * 4;

        normalPixels[pixel] = Math.round((normalX * 0.5 + 0.5) * 255);
        normalPixels[pixel + 1] = Math.round((normalZ * 0.5 + 0.5) * 255);
        normalPixels[pixel + 2] = Math.round((normalY * 0.5 + 0.5) * 255);
        normalPixels[pixel + 3] = 255;
      }
    }

    normalTexture.needsUpdate = true;
  }

  function makeWindRipple() {
    if (wind > 0 && frame % 15 === 0) {
      addRipple(
        Math.random() * waveSize,
        waveSize * (0.18 + Math.random() * 0.64),
        wind * 0.18,
        false,
      );
    }
  }

  function animate(now: number) {
    const delta = previousFrameTime === 0 ? 0 : Math.min((now - previousFrameTime) / 1000, 0.05);
    previousFrameTime = now;
    elapsed += delta;
    frame++;
    makeWindRipple();
    updateWaves();
    updateWaterSurface();
    updateShoreline(delta);
    updateSailboat(delta);
    updateFloatingSphere(delta);
    updateDuck(delta);
    updateWaterCollisions();
    updateFish(delta);
    updateNormalTexture();
    updateRippleRings();
    water.material.uniforms.time.value += delta * (0.2 + wind * 0.8);
    renderer.render(scene, camera);
    animationFrame = window.requestAnimationFrame(animate);
  }

  function dropAt(clientX: number, clientY: number, strength: number) {
    setPointerFromClient(clientX, clientY);
    const intersection = raycaster.intersectObject(water, false)[0];
    if (!intersection) return;

    rippleAtWorld(intersection.point.x, intersection.point.z, strength, true, { x: clientX, y: clientY });
  }

  function handleSailboatKeyDown(event: KeyboardEvent) {
    if (!["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight"].includes(event.code)) return;
    if (event.target instanceof HTMLElement &&
        event.target.closest("input, textarea, select, button, [contenteditable='true']")) return;

    event.preventDefault();
    sailboatKeys.add(event.code);
  }

  function handleSailboatKeyUp(event: KeyboardEvent) {
    sailboatKeys.delete(event.code);
  }

  function clearSailboatKeys() {
    sailboatKeys.clear();
  }

  window.addEventListener("keydown", handleSailboatKeyDown);
  window.addEventListener("keyup", handleSailboatKeyUp);
  window.addEventListener("blur", clearSailboatKeys);

  canvas.addEventListener("pointerdown", (event) => {
    if (event.button !== 0) return;
    event.preventDefault();
    canvas.focus({ preventScroll: true });
    setPointerFromClient(event.clientX, event.clientY);

    const sphereHit = raycaster.intersectObject(sphere, false)[0];
    if (sphereHit) {
      camera.getWorldDirection(cameraDirection);
      dragPlane.setFromNormalAndCoplanarPoint(cameraDirection, sphereHit.point);
      if (raycaster.ray.intersectPlane(dragPlane, dragIntersection)) {
        sphereDragging = true;
        activePointerId = event.pointerId;
        dragOffset.copy(sphere.position).sub(dragIntersection);
        sphereVelocity.set(0, 0, 0);
        previousSpherePosition.copy(sphere.position);
        lastDragTime = event.timeStamp;
        canvas.setPointerCapture(event.pointerId);
        canvas.style.cursor = "grabbing";
        return;
      }
    }

    cameraDragging = true;
    cameraPointerId = event.pointerId;
    cameraDragStart.set(event.clientX, event.clientY);
    cameraLastPointer.copy(cameraDragStart);
    cameraDragDistance = 0;
    canvas.setPointerCapture(event.pointerId);
    canvas.style.cursor = "grabbing";
  });

  canvas.addEventListener("pointermove", (event) => {
    if (sphereDragging && event.pointerId === activePointerId) {
      moveSphereWithPointer(event);
      return;
    }
    if (cameraDragging && event.pointerId === cameraPointerId) {
      updateCameraFromDrag(event);
      return;
    }

    setPointerFromClient(event.clientX, event.clientY);
    canvas.style.cursor = "grab";
  });

  function releaseSphere(event: PointerEvent) {
    if (!sphereDragging || event.pointerId !== activePointerId) return;

    sphereDragging = false;
    activePointerId = null;
    if (canvas.hasPointerCapture(event.pointerId)) canvas.releasePointerCapture(event.pointerId);
    canvas.style.cursor = "grab";
    sphereVelocity.y = Math.min(sphereVelocity.y, 1.2);
    if (sphereVelocity.length() > 6) sphereVelocity.setLength(6);
    previousSpherePosition.copy(sphere.position);
  }

  canvas.addEventListener("pointerup", releaseSphere);
  canvas.addEventListener("pointercancel", releaseSphere);

  function releaseCamera(event: PointerEvent, allowClickRipple: boolean) {
    if (!cameraDragging || event.pointerId !== cameraPointerId) return;

    cameraDragging = false;
    cameraPointerId = null;
    if (canvas.hasPointerCapture(event.pointerId)) canvas.releasePointerCapture(event.pointerId);
    canvas.style.cursor = "grab";
    if (allowClickRipple && cameraDragDistance < 6) {
      dropAt(cameraDragStart.x, cameraDragStart.y, 1.65);
    }
  }

  canvas.addEventListener("pointerup", (event) => releaseCamera(event, true));
  canvas.addEventListener("pointercancel", (event) => releaseCamera(event, false));

  dropButton.addEventListener("click", () => {
    const bounds = canvas.getBoundingClientRect();
    dropAt(bounds.left + bounds.width * (0.3 + Math.random() * 0.4), bounds.top + bounds.height * (0.3 + Math.random() * 0.4), 1.8);
  });

  windSlider.addEventListener("input", () => {
    wind = Number(windSlider.value) / 100;
    windOutput.value = `${windSlider.value}%`;
  });

  const resizeObserver = new ResizeObserver(resize);
  resizeObserver.observe(stage);
  resize();
  rippleAtWorld(0, (poolBack + poolFront) / 2, 0.65, false);
  animationFrame = window.requestAnimationFrame(animate);

  function dispose() {
    window.cancelAnimationFrame(animationFrame);
    window.clearTimeout(rippleImpactTimeout);
    window.removeEventListener("keydown", handleSailboatKeyDown);
    window.removeEventListener("keyup", handleSailboatKeyUp);
    window.removeEventListener("blur", clearSailboatKeys);
    resizeObserver.disconnect();
    normalTexture.dispose();
    for (const resource of disposableResources) resource.dispose();
    water.material.dispose();
    renderer.dispose();
  }

  window.addEventListener("pagehide", dispose, { once: true });
</script>

