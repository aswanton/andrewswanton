  .note + .note { padding-top: 19px; border-top: 1px solid #d8e1ed; }
  .note-number { color: #3468f5; font-size: .7rem; font-weight: 800; }
  .note h3 { margin: 0 0 5px; font-size: .95rem; letter-spacing: -.02em; }
