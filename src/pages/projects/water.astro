  function makeFinGeometry(points: Array<[number, number, number]>) {
    const positions = [0, 0, 0, ...points.flat()];
    const indices: number[] = [];
    for (let index = 0; index < points.length; index++) {
      indices.push(0, index + 1, ((index + 1) % points.length) + 1);
    }

    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute("position", new THREE.Float32BufferAttribute(positions, 3));
    geometry.setIndex(indices);
    geometry.computeVertexNormals();
    fishResourceGeometries.push(geometry);
    return geometry;
  }

  function createFishBody(archetype: FishArchetype, palette: (typeof fishPalettes)[number], pattern: number) {
    const rings = 20;
    const sides = 16;
    const positions: number[] = [];
    const colors: number[] = [];
    const indices: number[] = [];
    const baseColor = new THREE.Color(palette.base);
    const highlightColor = new THREE.Color(palette.light);
    const shadowColor = new THREE.Color(palette.dark);

    for (let ring = 0; ring <= rings; ring++) {
      const progress = ring / rings;
      const alongBody = progress * 2 - 1;
      const fullness = Math.pow(Math.sin(progress * Math.PI), 0.72);
      const headTaper = progress > 0.82 ? 1 - ((progress - 0.82) / 0.18) * 0.48 : 1;
      const tailTaper = progress < 0.14 ? 0.18 + (progress / 0.14) * 0.82 : 1;
      const radius = Math.max(0.018, fullness * headTaper * tailTaper);

      for (let side = 0; side <= sides; side++) {
        const angle = (side / sides) * Math.PI * 2;
        const vertical = Math.sin(angle);
        const horizontal = Math.cos(angle);
        positions.push(
          horizontal * radius * 0.36,
          vertical * radius * archetype.bodyDepth * 0.29,
          -alongBody * archetype.bodyLength * 0.5,
        );

        const band = pattern === 1 && Math.sin(progress * Math.PI * 12) > 0.5;
        const spot = pattern === 2 && Math.sin(progress * Math.PI * 9 + Math.cos(angle * 3) * 2.2) > 0.82;
        const color = vertical > 0.58 || band || spot
          ? shadowColor
          : vertical < -0.62
            ? highlightColor
            : baseColor;
        colors.push(color.r, color.g, color.b);

        if (ring < rings && side < sides) {
          const current = ring * (sides + 1) + side;
          const next = current + sides + 1;
          indices.push(current, next, current + 1, next, next + 1, current + 1);
        }
      }
    }

    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute("position", new THREE.Float32BufferAttribute(positions, 3));
    geometry.setAttribute("color", new THREE.Float32BufferAttribute(colors, 3));
    geometry.setIndex(indices);
    geometry.computeVertexNormals();
    fishResourceGeometries.push(geometry);
    return geometry;
  }

  function createFish(archetype: FishArchetype, index: number) {
