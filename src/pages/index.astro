
---
const projects = [
  {
    title: "Engineering Toolbox",
    description: "Interactive calculators and utilities for electronics engineering.",
    status: "In development",
  },
  {
    title: "ADC Visualizer",
    description: "Explore sampling, quantization, resolution, and signal noise.",
    status: "Planned",
  },
  {
    title: "Experiments",
    description: "Technical experiments, simulations, and things I'm learning.",
    status: "Ongoing",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#101318" />
    <meta
      name="description"
      content="Engineering projects, interactive tools, and technical experiments by Andrew Swanton."
    />
    <title>Andrew Swanton | Engineering & Experiments</title>
  </head>

  <body>
    <main>
      <header>
        <a class="logo" href="/">AS<span>.</span></a>
        <nav>
          <a href="#projects">Projects</a>
          <a href="#about">About</a>
        </nav>
      </header>

      <section class="hero">
        <p class="eyebrow">ENGINEERING · EXPERIMENTS · BUILDING</p>
        <h1>Ideas are better<br />when you <span>build them.</span></h1>
        <p class="intro">
          I'm Andrew. This is my corner of the internet for engineering
          projects, interactive tools, and experiments worth sharing.
        </p>
        <a class="cta" href="#projects">Explore my projects ↘</a>
      </section>

      <section id="projects">
        <p class="eyebrow">SELECTED WORK</p>
        <h2>Things I'm building.</h2>
        <div class="projects">
          {projects.map((project, index) => (
            <article class="project">
              <p class="number">0{index + 1} / PROJECT</p>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <span class="status">{project.status}</span>
            </article>
          ))}
        </div>
      </section>

      <section id="about" class="about">
        <p class="eyebrow">A LITTLE ABOUT THIS SITE</p>
        <h2>A place to build in public.</h2>
        <p>
          This site is an evolving collection of projects, technical notes,
          and ideas. Some will become useful tools; others are simply
          experiments in learning something new.
        </p>
      </section>

      <footer>
        <span>© {new Date().getFullYear()} Andrew Swanton</span>
        <a href="mailto:hello@andrewswanton.com">Get in touch ↗</a>
      </footer>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) {
    margin: 0;
    background: #101318;
    color: #edf0f5;
    font-family: system-ui, -apple-system, sans-serif;
    line-height: 1.6;
  }
  main { max-width: 1080px; margin: auto; padding: 0 28px; }
  header, footer {
    display: flex; justify-content: space-between;
    align-items: center; padding: 28px 0;
    border-bottom: 1px solid #2b303a;
  }
  .logo { font-size: 1.5rem; font-weight: 800; color: inherit; }
  .logo span, h1 span { color: #80e0c0; }
  nav { display: flex; gap: 24px; }
  a { color: inherit; text-decoration: none; }
  nav a, footer a { color: #aeb6c5; }
  .hero { padding: 110px 0 120px; max-width: 760px; }
  .eyebrow, .number {
    color: #80e0c0; font-size: .76rem;
    letter-spacing: .14em; font-weight: 700;
  }
  h1 { font-size: clamp(3rem, 8vw, 6rem); line-height: 1.05; letter-spacing: -.06em; margin: 24px 0; }
  h2 { font-size: clamp(2rem, 5vw, 3rem); line-height: 1.15; letter-spacing: -.04em; }
  h3 { font-size: 1.4rem; margin-bottom: 8px; }
  .intro { color: #aeb6c5; font-size: 1.15rem; max-width: 590px; margin-bottom: 32px; }
  .cta { display: inline-block; background: #80e0c0; color: #101318; padding: 12px 18px; border-radius: 5px; font-weight: 700; }
  #projects { padding: 50px 0 90px; }
  .projects { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-top: 32px; }
  .project { border: 1px solid #303640; border-radius: 10px; padding: 24px; background: #171b22; }
  .project > p:not(.number), .about > p:last-child { color: #aeb6c5; }
  .status { font-size: .8rem; color: #80e0c0; }
  .about { border-top: 1px solid #303640; padding: 65px 0; max-width: 700px; }
  footer { border-bottom: 0; border-top: 1px solid #303640; color: #aeb6c5; font-size: .9rem; }
  @media (max-width: 520px) {
    main { padding: 0 20px; }
    .hero { padding: 75px 0; }
    nav { gap: 14px; }
  }
</style>
